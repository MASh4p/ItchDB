@page "/tags/{Slug}"
@inherits AnalyticsPage

<PageTitle>@(_vm?.Stats.Name ?? Slug) — ItchDB</PageTitle>

<DataGate Snapshot="A" Busy="Computing" Error="@ComputeError">
    @if (_vm is null)
    {
        @if (!Computing)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@Txt.S($"Сегмент «{Slug}» не найден в собранных данных.", $"Segment “{Slug}” was not found in the collected data.")</MudAlert>
        }
    }
    else
    {
        var s = _vm.Stats;
        <div class="d-flex flex-wrap align-center gap-3 mb-1">
            <MudText Typo="Typo.h4">@s.Name</MudText>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Segments.KindName(s.Segment.Kind)</MudChip>
            <QuadrantChip @key="@($"{s.Key}:{Txt.Lang}")" Value="s.Quadrant" />
            <MudSpacer />
            @if (_vm.ItchUrl is not null)
            {
                <MudButton Href="@_vm.ItchUrl" Target="_blank" Variant="Variant.Outlined" Size="Size.Small" EndIcon="@Icons.Material.Filled.OpenInNew">@Txt.S("На itch.io", "On itch.io")</MudButton>
            }
            @if (_vm.Tag is not null)
            {
                <MudButton Href="@($"/developer?tab=concept&tags={Uri.EscapeDataString(_vm.Tag.Slug)}")" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Lightbulb">@Txt.S("Проверить идею с этим тегом", "Check an idea with this tag")</MudButton>
            }
        </div>
        @if (!string.IsNullOrEmpty(_vm.Tag?.Description))
        {
            <MudText Class="itch-muted mb-2">@_vm.Tag.Description</MudText>
        }
        <MudText Class="mb-4">@_vm.Summary</MudText>

        @if (s.SmallSample)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                @Txt.S($"Меньше {A.Params.MinSegmentSample} игр с оценками — цифры ниже шумные, сегмент не участвует в рейтинге ниш.",
                       $"Fewer than {A.Params.MinSegmentSample} rated games — the numbers below are noisy, and this segment is left out of the niche ranking.")
            </MudAlert>
        }

        <MudGrid Spacing="3" Class="mb-1">
            <MudItem xs="6" sm="4" md="3" lg="2">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="@(s.IncludesUnrated ? Txt.S("Игр на itch.io", "Games on itch.io") : Txt.S("Игр с оценками", "Rated games"))" Value="@((s.DenominatorEstimated ? "≈" : "") + Fmt.Short(s.Denominator))" Large="true"
                         Hint="@(s.ThisWeek is { } addedThisWeek ? Txt.S($"в базе {Fmt.N(s.Known)} · +{Fmt.N(addedThisWeek)} за неделю", $"in the database {Fmt.N(s.Known)} · +{Fmt.N(addedThisWeek)} this week") : Txt.S($"в базе {Fmt.N(s.Known)}", $"in the database {Fmt.N(s.Known)}"))"
                         Formula="@Formulas.Competition.Formula" Tip="@Formulas.Competition.Text" />
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="4" md="3" lg="2">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="@(Ui.DemandUsesMean ? Txt.S("Среднее оценок", "Mean ratings") : Txt.S("Медиана оценок", "Median ratings"))" Value="@Fmt.N(Ui.DemandUsesMean ? s.Mean : s.Median, Ui.DemandUsesMean ? 1 : 0)" Large="true"
                         Hint="@Txt.S($"сглаженное {Fmt.N(Ui.DemandUsesMean ? s.AdjMean : s.AdjMedian, 1)} · {Fmt.Times(_vm.VsAll)} к itch.io", $"smoothed {Fmt.N(Ui.DemandUsesMean ? s.AdjMean : s.AdjMedian, 1)} · {Fmt.Times(_vm.VsAll)} vs itch.io")"
                         Formula="@(Ui.DemandUsesMean ? Formulas.Mean(F.MinRatings).Formula : Formulas.Median(F.MinRatings).Formula)"
                         Tip="@(Ui.DemandUsesMean ? Formulas.Mean(F.MinRatings).Text : Formulas.Median(F.MinRatings).Text)" />
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="4" md="3" lg="2">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="@Txt.S("Лучшие 10%", "Top 10%")" Value="@($"{Fmt.N(s.P90, 0)}+")" Large="true" Hint="@($"P75: {Fmt.N(s.P75, 0)}")"
                         Formula="@Formulas.Quantiles.Formula" Tip="@Formulas.Quantiles.Text" />
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="4" md="3" lg="2">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="@Txt.S($"Шанс {A.Params.SuccessThreshold}+ оценок", $"Chance of {A.Params.SuccessThreshold}+ ratings")" Value="@Fmt.Pct(s.SuccessShare, 1)" Large="true" Color="#4CC38A"
                         Hint="@Txt.S($"95%: {Fmt.Pct(s.SuccessLow, 1)}–{Fmt.Pct(s.SuccessHigh, 1)} · по itch.io {Fmt.Pct(_vm.All.SuccessShare, 1)}", $"95%: {Fmt.Pct(s.SuccessLow, 1)}–{Fmt.Pct(s.SuccessHigh, 1)} · itch.io overall {Fmt.Pct(_vm.All.SuccessShare, 1)}")"
                         Formula="@Formulas.Success(A.Params.SuccessThreshold).Formula" Tip="@Formulas.Success(A.Params.SuccessThreshold).Text" />
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="4" md="3" lg="2">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="@Txt.S("Тренд", "Trend")" Value="@(s.Trend is { } t ? Fmt.Signed(t * 100, 0, "%") : "—")" Large="true"
                         Color="@(s.Trend is >= 0.15 ? "#4CC38A" : s.Trend is <= -0.15 ? "#FF8A8A" : null)"
                         Hint="@Txt.S($"успешных {s.RecentSuccesses} против {s.EarlierSuccesses}", $"successes {s.RecentSuccesses} vs {s.EarlierSuccesses}")"
                         Formula="@Formulas.Trend(_vm.Cohorts).Formula" Tip="@Formulas.Trend(_vm.Cohorts).Text" />
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="4" md="3" lg="2">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="Opportunity" Value="@Fmt.N(s.Opportunity, 0)" Large="true" Color="@QuadrantChip.Color(s.Quadrant)"
                         Hint="@Txt.S($"порог входа {Fmt.N(s.EntryThreshold, 0)} оценок", $"entry bar {Fmt.N(s.EntryThreshold, 0)} ratings")"
                         Formula="@Formulas.Opportunity(A.Params.WeightDemand, A.Params.WeightSuccess, A.Params.WeightCompetition, A.Params.WeightTrend).Formula"
                         Tip="@Formulas.Opportunity(A.Params.WeightDemand, A.Params.WeightSuccess, A.Params.WeightCompetition, A.Params.WeightTrend).Text" />
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 mb-3" Outlined="true">
                    <div class="itch-section-title">@Txt.S("Сколько оценок набирают игры сегмента", "How many ratings games in this segment collect")</div>
                    <BarChart Items="_vm.Distribution" Name="@Txt.S("Игр", "Games")" Height="250" Logarithmic="true" />
                </MudPaper>
                <MudPaper Class="pa-4 mb-3" Outlined="true">
                    <div class="itch-section-title">@Txt.S("По годам выхода", "By release year")</div>
                    <SeriesChart Series="_vm.Years" Height="260" LeftTitle="@Txt.S("Игр", "Games")" RightTitle="@Txt.S("Среднее оценок", "Mean ratings")" />
                </MudPaper>
                @if (_vm.History.Count > 0)
                {
                    <MudPaper Class="pa-4 mb-3" Outlined="true">
                        <div class="itch-section-title">@Txt.S("Динамика по снимкам", "Change across snapshots")</div>
                        <SeriesChart Series="_vm.History" Height="240" LeftTitle="@Txt.S("Проектов", "Projects")" RightTitle="@Txt.S("Медиана", "Median")" />
                    </MudPaper>
                }
                @if (_vm.Combos.Count > 0)
                {
                    <MudPaper Class="pa-4 mb-3" Outlined="true">
                        <div class="itch-section-title">
                            @Txt.S("С чем сочетается лучше всего", "Best combinations")
                            <FormulaTip Title="@Formulas.Lift.Title" Formula="@Formulas.Lift.Formula" Text="@Formulas.Lift.Text" />
                        </div>
                        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Style="background:transparent">
                            <thead><tr><th>@Txt.S("+ тег", "+ tag")</th><th style="text-align:right">@Txt.S("Игр", "Games")</th><th style="text-align:right">@Txt.S("Медиана", "Median")</th><th style="text-align:right">Lift</th><th style="text-align:right">@Txt.S("Шанс", "Chance")</th></tr></thead>
                            <tbody>
                                @foreach (var c in _vm.Combos)
                                {
                                    var other = c.A.Id == _vm.Tag!.Id ? c.B : c.A;
                                    <tr>
                                        <td><MudLink Href="@($"/tags/{Uri.EscapeDataString(other.Slug)}")">@Segments.DisplayName(other)</MudLink></td>
                                        <td class="itch-num" style="text-align:right">@Fmt.N(c.Games)</td>
                                        <td class="itch-num" style="text-align:right">@Fmt.N(c.Median, 0)</td>
                                        <td class="itch-num" style="text-align:right;color:@(c.Lift >= 1.2 ? "#4CC38A" : c.Lift < 0.9 ? "#FF8A8A" : "inherit")">@Fmt.Times(c.Lift)</td>
                                        <td class="itch-num" style="text-align:right">@Fmt.Pct(c.SuccessShare, 1)</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </MudPaper>
                }
                @if (_vm.Related.Count > 0)
                {
                    <MudPaper Class="pa-4" Outlined="true">
                        <div class="itch-section-title">@Txt.S("Связанные теги на itch.io", "Related tags on itch.io")</div>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var (tag, stats) in _vm.Related)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Href="@($"/tags/{Uri.EscapeDataString(tag.Slug)}")">
                                    @Segments.DisplayName(tag)
                                    @if (stats is not null && !double.IsNaN(Ui.DemandUsesMean ? stats.Mean : stats.Median))
                                    {
                                        <span class="itch-muted ml-1">· @Fmt.N(Ui.DemandUsesMean ? stats.Mean : stats.Median, Ui.DemandUsesMean ? 1 : 0)</span>
                                    }
                                </MudChip>
                            }
                        </div>
                    </MudPaper>
                }
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-2 mb-3" Outlined="true">
                    <GamesTable Games="_vm.Top" Title="@Txt.S("Лидеры по оценкам", "Leaders by ratings")" ExportName="@($"top-{Slug}")" RowsPerPage="10" Compact="true" BayesMinVotes="A.Params.BayesMinVotes" />
                </MudPaper>
                @if (_vm.Hot.Count > 0)
                {
                    <MudPaper Class="pa-2 mb-3" Outlined="true">
                        <GamesTable Games="_vm.Hot" Title="@Txt.S("Горячее", "Hot")" ExportName="@($"hot-{Slug}")" RowsPerPage="10" ShowHot="true" ShowDelta="true" ShowWr="false" Compact="true" BayesMinVotes="A.Params.BayesMinVotes" />
                    </MudPaper>
                }
                <MudPaper Class="pa-2" Outlined="true">
                    <GamesTable Games="_vm.Recent" Title="@Txt.S("Успешные новинки", "Successful new games")" Subtitle="@Txt.S($"вышли за 12 мес, ≥ {A.Params.SuccessThreshold} оценок", $"released in 12 months, ≥ {A.Params.SuccessThreshold} ratings")" ExportName="@($"recent-{Slug}")" RowsPerPage="10"
                                ShowWr="false" Compact="true" Empty="@Txt.S("Нет свежих игр с заметным числом оценок.", "No recent games with a noticeable number of ratings.")" BayesMinVotes="A.Params.BayesMinVotes" />
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</DataGate>

@code {
    [Parameter] public string Slug { get; set; } = "";

    private sealed record Vm(
        SegmentStats Stats,
        SegmentStats All,
        TagRow? Tag,
        string? ItchUrl,
        string Summary,
        double? VsAll,
        string Cohorts,
        List<ChartPoint> Distribution,
        List<ChartSeries> Years,
        List<ChartSeries> History,
        List<GameRow> Top,
        List<GameRow> Hot,
        List<GameRow> Recent,
        List<TagComboResult> Combos,
        List<(TagRow Tag, SegmentStats? Stats)> Related);

    private Vm? _vm;
    private string? _loaded;
    private List<SegmentStatsSnapshot> _history = [];

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded == Slug) return;
        _loaded = Slug;
        _history = await Analytics.SegmentHistoryAsync(Slug);
        await RecomputeAsync();
    }

    protected override void Compute()
    {
        if (A.Segment(F, Slug) is not { } s)
        {
            _vm = null;
            return;
        }
        var tag = D.Tag(Slug);
        var all = A.All(F);
        var members = Segments.Members(D, s.Segment, F).ToList();

        (string Label, int From, int To)[] bins =
            [("1–4", 1, 4), ("5–9", 5, 9), ("10–24", 10, 24), ("25–49", 25, 49), ("50–99", 50, 99), ("100–249", 100, 249), ("250–999", 250, 999), ("1000+", 1000, int.MaxValue)];
        var distribution = new List<ChartPoint> { new("0", s.Bin0) };
        distribution.AddRange(bins.Select(b => new ChartPoint(b.Label, members.Count(g => g.RatingsKnown && g.Ratings >= b.From && g.Ratings <= b.To))));

        var years = Trends.ByYear(D, F, A.Params, members, s.Segment.FilterKey is { Length: > 0 } fk ? fk : null)
            .Where(y => y.Year >= 2015 && (y.TotalItch is not null || y.Known >= 5)).ToList();
        var yearSeries = ChartData.Years(years);

        var history = new List<ChartSeries>();
        if (tag is { History.Count: >= 2 })
            history.Add(new ChartSeries(Txt.S("Проектов (itch.io/tags)", "Projects (itch.io/tags)"), tag.History.Select(h => new ChartPoint(Fmt.Date(h.Day), h.Projects)).ToList(), ChartKind.Line, Color: "#5CC8FA"));
        if (_history.Count >= 2)
            history.Add(new ChartSeries(Txt.S("Медиана оценок", "Median ratings"), _history.Select(h => new ChartPoint(Fmt.Date(h.Day), h.MedianRatings)).ToList(), ChartKind.Line, SecondAxis: history.Count > 0, Color: ItchTheme.Accent));

        var top = members.Where(g => g.Ratings > 0).OrderByDescending(g => g.Ratings).Take(100).ToList();
        var hot = members.Where(g => g.Hot > 0).OrderByDescending(g => g.Hot).Take(50).ToList();
        var recent = members.Where(g => g.AgeDays(A.Now) <= 365 && (g.PublishedAt is not null || g.Year is not null) && g.Ratings >= A.Params.SuccessThreshold)
            .OrderByDescending(g => g.Ratings / Math.Max(7, g.AgeDays(A.Now))).Take(50).ToList();

        var combos = tag is null ? [] : A.Combos(F, tag.Id)
            .Where(c => (c.A.Id == tag.Id || c.B.Id == tag.Id) && !double.IsNaN(c.Lift))
            .OrderByDescending(c => c.Lift).Take(15).ToList();

        var related = tag is null ? [] : tag.Related.Select(D.Tag).OfType<TagRow>()
            .Where(t => F.ShowNsfw || !ItchCatalog.NsfwTags.Contains(t.Slug))
            .Select(t => (t, A.Segment(F, t.Slug))).ToList();

        var segDemand = Ui.DemandUsesMean ? s.AdjMean : s.AdjMedian;
        var allDemand = Ui.DemandUsesMean ? all.AdjMean : all.AdjMedian;
        var vsAll = allDemand > 0 ? segDemand / allDemand : (double?)null;
        var cohorts = A.Analyzer(F).TrendCohorts;
        var itchUrl = s.Segment.FilterKey is { Length: > 0 } filter ? $"{ItchCatalog.BaseUrl}/games/{filter}" : null;

        _vm = new Vm(s, all, tag, itchUrl, Summarize(s, all, vsAll), vsAll, cohorts, distribution, yearSeries, history, top, hot, recent, combos, related);
    }

    private string Summarize(SegmentStats s, SegmentStats all, double? vsAll)
    {
        var times = Fmt.Times(vsAll).TrimStart('×');
        var demand = vsAll switch
        {
            >= 1.3 => Txt.S($"Спрос выше среднего: типичная игра набирает в {times} раза больше оценок, чем по itch.io в целом.", $"Demand is above average: a typical game collects {times} times more ratings than on itch.io overall."),
            <= 0.77 => Txt.S($"Спрос ниже среднего: типичная игра набирает меньше оценок, чем по itch.io в целом ({Fmt.Times(vsAll)}).", $"Demand is below average: a typical game collects fewer ratings than on itch.io overall ({Fmt.Times(vsAll)})."),
            _ => Txt.S("Спрос на уровне itch.io в целом.", "Demand is in line with itch.io overall."),
        };
        var competition = s.CompetitionPct switch
        {
            >= 0.75 => Txt.S("Конкуренция высокая — это один из самых заполненных сегментов.", "Competition is high — this is one of the most crowded segments."),
            <= 0.25 => Txt.S("Конкуренция низкая — игр в сегменте немного.", "Competition is low — the segment does not have many games."),
            _ => Txt.S("Конкуренция средняя.", "Competition is moderate."),
        };
        var chance = all.SuccessShare > 0
            ? Txt.S($"Шанс набрать {A.Params.SuccessThreshold}+ оценок — {Fmt.Pct(s.SuccessShare, 1)} против {Fmt.Pct(all.SuccessShare, 1)} по всему itch.io.", $"The chance of {A.Params.SuccessThreshold}+ ratings is {Fmt.Pct(s.SuccessShare, 1)} versus {Fmt.Pct(all.SuccessShare, 1)} across itch.io.")
            : "";
        return $"{demand} {competition} {chance}";
    }
}
