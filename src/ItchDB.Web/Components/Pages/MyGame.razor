    private string ListLabel(string listKey)
    {
        if (listKey == "popular") return Txt.S("Популярное (весь itch.io)", "Popular (all of itch.io)");
        if (listKey == "new-and-popular") return Txt.S("Новое и популярное", "New and popular");
        var slash = listKey.IndexOf('/');
        if (slash < 0) return listKey;
        var filter = listKey[(slash + 1)..];
        var prefix = listKey[..slash] switch
        {
            "popular" => Txt.S("Популярное", "Popular"),
            "new-and-popular" => Txt.S("Новое и популярное", "New and popular"),
            "top-rated" => Txt.S("Лучшие по оценкам", "Top rated"),
            _ => listKey[..slash],
        };
        var names = filter.Split('/').Select(f => D.Tag(f) is { } t ? Segments.DisplayName(t) : ItchCatalog.NameFromSlug(f));
        return $"{prefix}: {string.Join(" + ", names)}";
    }

    private string ApiError(Exception ex)
    {
        if (ex is not ItchApiException)
            return Txt.S($"Не удалось обратиться к api.itch.io: {ex.Message}", $"Could not reach api.itch.io: {ex.Message}");
        var message = ex.Message;
        const string rejected = "itch.io отклонил ключ API";
        if (message.StartsWith(rejected, StringComparison.Ordinal))
            return Txt.S(message, "itch.io rejected the API key. Create a new one at itch.io/user/settings/api-keys.");
        const string http = "itch.io API ответил HTTP ";
        if (message.StartsWith(http, StringComparison.Ordinal))
        {
            var code = message[http.Length..].TrimEnd('.');
            return Txt.S(message, $"The itch.io API returned HTTP {code}.");
        }
        return message;
    }

    private void OnCrawlChanged() => InvokeAsync(StateHasChanged);

    private void OnRunFinished(CrawlProfile profile, CrawlRunStatus status) => InvokeAsync(async () =>
    {
        _tracked = await Queries.TrackedAsync();
        await RecomputeAsync();
        StateHasChanged();
    });

    public override void Dispose()
    {
        Crawl.Changed -= OnCrawlChanged;
        Crawl.RunFinished -= OnRunFinished;
        base.Dispose();
    }
}
