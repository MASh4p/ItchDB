@page "/games/{Id:long}"
@inherits AnalyticsPage
@inject DataQueries Queries
@inject ISnackbar Snackbar

<PageTitle>@(_vm?.Game.Title ?? Txt.S("Игра", "Game")) — ItchDB</PageTitle>

<DataGate Snapshot="A" Busy="Computing" Error="@ComputeError">
    @if (_vm is null)
    {
        @if (!Computing)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@Txt.S($"Игры с id {Id} нет в базе (или она скрыта фильтром «18+»).", $"No game with id {Id} is in the database (or it is hidden by the 18+ filter).")</MudAlert>
        }
    }
    else
    {
        var g = _vm.Game;
        <div class="d-flex flex-wrap gap-5 mb-4">
            @if (!string.IsNullOrEmpty(g.CoverUrl))
            {
                <img src="@g.CoverUrl" alt="" class="itch-cover-lg" loading="lazy" referrerpolicy="no-referrer" />
            }
            <div style="flex:1;min-width:300px">
                <MudText Typo="Typo.h4">@g.Title</MudText>
                <MudText Class="mb-2">
                    @if (g.DeveloperId is { } devId)
                    {
                        <MudLink Href="@($"/developers/{devId}")">@(g.AuthorName ?? _vm.Developer?.Name ?? Txt.S("автор", "author"))</MudLink>
                    }
                    else
                    {
                        <span class="itch-muted">@g.AuthorName</span>
                    }
                    @if (_vm.Developer?.Followers is { } followers)
                    {
                        <span class="itch-muted"> · @Txt.S(Fmt.Count(followers, "подписчик", "подписчика", "подписчиков"), $"{Fmt.N(followers)} {(followers == 1 ? "follower" : "followers")}")</span>
                    }
                </MudText>
                @if (!string.IsNullOrEmpty(g.ShortText))
                {
                    <MudText Class="itch-muted mb-3">@g.ShortText</MudText>
                }
                <div class="d-flex flex-wrap gap-1 mb-3">
                    @if (g.Genre is not null)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Href="@($"/tags/{g.Genre}")">@GamesTable.GenreName(g.Genre)</MudChip>
                    }
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Fmt.Price(g)</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Fmt.Platforms(g.Platforms)</MudChip>
                    @if (g.Status != GameStatus.Unknown)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Fmt.Status(g.Status)</MudChip>
                    }
                    @if (g.IsFeatured)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Featured @Fmt.Date(g.FeaturedAt)</MudChip>
                    }
                    @if (g.IsJamEntry)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@Txt.S("Джем", "Jam")</MudChip>
                    }
                    @if (g.Ai == AiUsage.UsesAi)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Txt.S("Генеративный ИИ", "Generative AI")</MudChip>
                    }
                    @if (g.IsNsfw)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">18+</MudChip>
                    }
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <MudButton Href="@g.Url" Target="_blank" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" EndIcon="@Icons.Material.Filled.OpenInNew">@Txt.S("Открыть на itch.io", "Open on itch.io")</MudButton>
                    <MudButton OnClick="TrackAsync" Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.TrackChanges">@Txt.S("Отслеживать позиции", "Track positions")</MudButton>
                </div>
                <table class="itch-kv mt-3" style="font-size:.85rem">
                    <tr><td>@Txt.S("Опубликована", "Published")</td><td>@(g.PublishedAt is { } p ? Fmt.Date(p) : g.Year?.ToString() ?? "—")</td></tr>
                    @if (_entity?.ReleaseDate is { } rel)
                    {
                        <tr><td>@Txt.S("Дата релиза", "Release date")</td><td>@Fmt.Date(rel)</td></tr>
                    }
                    @if (_entity?.UpdatedAt is { } upd)
                    {
                        <tr><td>@Txt.S("Обновлена", "Updated")</td><td>@Fmt.Date(upd)</td></tr>
                    }
                    <tr><td>@Txt.S("Впервые замечена", "First seen")</td><td>@Fmt.Date(g.FirstSeenAt)</td></tr>
                    <tr><td>@Txt.S("Страница игры", "Game page")</td><td>@(_entity?.DetailsFetchedAt is { } df ? Txt.S($"прочитана {Fmt.Ago(df)}", $"read {Fmt.Ago(df)}") : Txt.S("ещё не прочитана — теги и даты только из списков", "not read yet — tags and dates come only from lists"))</td></tr>
                    @if (g.HasDetails)
                    {
                        <tr><td>@Txt.S("Скриншотов", "Screenshots")</td><td>@g.Screenshots</td></tr>
                    }
                </table>
            </div>
        </div>

        <MudGrid Spacing="3" Class="mb-1">
            <MudItem xs="6" sm="4" md="2">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="@Txt.S("Оценок", "Ratings")" Value="@(g.RatingsKnown ? Fmt.N(g.Ratings) : "?")" Large="true"
                         Hint="@(g.DeltaRatings is { } d ? Txt.S($"{Fmt.Signed(d)} за {Fmt.Count(g.DeltaDays, "день", "дня", "дней")}", $"{Fmt.Signed(d)} over {Fmt.N(g.DeltaDays)} {(g.DeltaDays == 1 ? "day" : "days")}") : Txt.S("прирост появится со снимками", "the change appears once there are snapshots"))" />
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="4" md="2">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="@Txt.S("Средняя оценка", "Average rating")" Value="@Fmt.Stars(g.RatingAvg)" Large="true"
                         Hint="@(g.WeightedRating > 0 ? $"WR {g.WeightedRating.ToString("0.00", Fmt.Ru)}" : null)"
                         Formula="@Formulas.WeightedRating(A.Params.BayesMinVotes).Formula" Tip="@Formulas.WeightedRating(A.Params.BayesMinVotes).Text" />
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="4" md="2">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="@Txt.S("Комментариев", "Comments")" Value="@Fmt.N(g.Comments)" Large="true"
                         Hint="@(g.DeltaComments is { } dc ? Txt.S($"{Fmt.Signed(dc)} за окно снимков", $"{Fmt.Signed(dc)} over the snapshot window") : null)" />
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="4" md="2">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="@Txt.S("Лучше, чем", "Better than")" Value="@Fmt.Pct(_vm.GlobalBetter)" Large="true" Hint="@Txt.S("игр itch.io по числу оценок", "of itch.io games by rating count")"
                         Tip="@Txt.S("Доля всех игр каталога (включая игры без оценок), у которых оценок меньше.", "Share of all catalog games (including unrated ones) that have fewer ratings.")" />
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="4" md="2">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="Hot" Value="@(g.Hot > 0 ? Fmt.N(g.Hot, 2) : "—")" Large="true"
                         Hint="@(g.PopularRank is { } pr ? Txt.S($"#{pr} в «Популярном»", $"#{pr} in Popular") : null)"
                         Formula="@Formulas.Hot.Formula" Tip="@Formulas.Hot.Text" />
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="4" md="2">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="@Txt.S("Просмотров ≈", "Views ≈")" Value="@(_vm.Audience.BelowDetection ? Txt.S("мало", "few") : Fmt.Short(_vm.Audience.Views))" Large="true" Color="#5CC8FA"
                         Hint="@($"{Fmt.Short(_vm.Audience.ViewsLow)}–{Fmt.Short(_vm.Audience.ViewsHigh)}{(_vm.Audience.Calibrated ? Txt.S(" · калибровано", " · calibrated") : "")}")"
                         Formula="@Formulas.Audience.Formula" Tip="@Formulas.Audience.Text" />
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="3">
            <MudItem xs="12" md="7">
                <MudPaper Class="pa-4 mb-3" Outlined="true">
                    <div class="itch-section-title">@Txt.S("История по дням", "History by day")</div>
                    @if (_vm.History.Count > 0 && _vm.History[0].Points.Count >= 2)
                    {
                        <SeriesChart Series="_vm.History" Height="260" LeftTitle="@Txt.S("Оценок", "Ratings")" RightTitle="@Txt.S("Комментариев", "Comments")" />
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="itch-muted">
                            @Txt.S($"Снимков пока {_history.Count}. График появится, когда игра попадёт в сбор хотя бы в два разных дня.",
                                   $"There are {_history.Count} snapshots so far. The chart appears once the game is collected on at least two different days.")
                        </MudText>
                    }
                </MudPaper>

                <MudPaper Class="pa-4 mb-3" Outlined="true">
                    <div class="itch-section-title">
                        @Txt.S("Место в сегментах", "Place in segments")
                        <FormulaTip Title="@Txt.S("Место в сегменте", "Place in a segment")" Formula="@Txt.S("лучше, чем = (игр без оценок + игр с меньшим числом оценок) / игр в сегменте на itch.io", "better than = (unrated games + games with fewer ratings) / games in the segment on itch.io")"
                                    Text="@Txt.S("Показывает, насколько игра выделяется среди своих тегов. Место — по числу оценок среди собранных игр сегмента.", "Shows how the game stands out among its tags. Place is by rating count among collected games in the segment.")" />
                    </div>
                    @if (_vm.Segments.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="itch-muted">@Txt.S("У игры пока нет тегов в базе — откройте её страницу через глубокий сбор.", "This game has no tags in the database yet — read its page with a deep crawl.")</MudText>
                    }
                    else
                    {
                        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Style="background:transparent">
                            <thead>
                                <tr><th>@Txt.S("Сегмент", "Segment")</th><th style="text-align:right">@Txt.S("Место", "Place")</th><th style="text-align:right">@Txt.S("Лучше, чем", "Better than")</th><th style="text-align:right">@Txt.S("Медиана", "Median")</th><th style="text-align:right">P90</th><th>@Txt.S("Квадрант", "Quadrant")</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var s in _vm.Segments)
                                {
                                    <tr>
                                        <td><MudLink Href="@($"/tags/{Uri.EscapeDataString(s.Stats.Key)}")">@s.Stats.Name</MudLink></td>
                                        <td class="itch-num" style="text-align:right">#@Fmt.N(s.Rank) <span class="itch-muted">@Txt.S($"из {Fmt.Short(s.Stats.Denominator)}", $"of {Fmt.Short(s.Stats.Denominator)}")</span></td>
                                        <td class="itch-num" style="text-align:right">@Fmt.Pct(s.Better)</td>
                                        <td class="itch-num" style="text-align:right">@Fmt.N(s.Stats.Median, 0)</td>
                                        <td class="itch-num" style="text-align:right">@Fmt.N(s.Stats.P90, 0)</td>
                                        <td><QuadrantChip @key="@($"{s.Stats.Key}:{Txt.Lang}")" Value="s.Stats.Quadrant" /></td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </MudPaper>

                <MudPaper Class="pa-4" Outlined="true">
                    <div class="itch-section-title">@Txt.S("Похожие игры (по общим тегам)", "Similar games (by shared tags)")</div>
                    @if (_vm.Similar.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="itch-muted">@Txt.S("Не нашлось игр хотя бы с двумя общими тегами.", "No games share at least two tags.")</MudText>
                    }
                    @foreach (var (other, sim) in _vm.Similar)
                    {
                        <div class="d-flex align-center py-1 gap-3">
                            <div style="flex:1;min-width:0"><GameCell Game="other" /></div>
                            <span class="itch-muted" style="font-size:.78rem">@Txt.S($"сходство {Fmt.Pct(sim)}", $"similarity {Fmt.Pct(sim)}")</span>
                            <span class="itch-num" style="width:90px;text-align:right">@Txt.S($"{Fmt.N(other.Ratings)} оц.", $"{Fmt.N(other.Ratings)} ratings")</span>
                        </div>
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="5">
                <MudPaper Class="pa-4 mb-3" Outlined="true">
                    <div class="itch-section-title">
                        @Txt.S("Позиции в списках itch.io", "Positions in itch.io lists")
                        <FormulaTip Title="@Txt.S("Позиции", "Positions")" Text="@Txt.S($"Последний обход списков «Популярное» ({Fmt.Date(D.PositionsDay)}). Показаны соседи сверху и снизу: с кем игра делит видимость.", $"Last pass of the Popular lists ({Fmt.Date(D.PositionsDay)}). Neighbors above and below are shown: who the game shares visibility with.")" />
                    </div>
                    @if (_vm.Positions.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="itch-muted">@Txt.S("В собранных списках «Популярное» игры нет. Добавьте её в отслеживание — сборщик будет искать её глубже.", "This game is not in the collected Popular lists. Track it and the crawler will look further down.")</MudText>
                    }
                    @foreach (var pos in _vm.Positions.Take(8))
                    {
                        <div class="mb-3">
                            <div class="d-flex align-center">
                                <b>@ListLabel(pos.ListKey)</b>
                                <MudSpacer />
                                <span class="itch-num" style="font-size:1.1rem">#@pos.Position</span>
                                @if (_bestPositions.TryGetValue(pos.ListKey, out var best) && best < pos.Position)
                                {
                                    <span class="itch-muted ml-2" style="font-size:.78rem">@Txt.S($"лучшее #{best}", $"best #{best}")</span>
                                }
                            </div>
                            @foreach (var (np, ng) in pos.Neighbors)
                            {
                                <div class="d-flex align-center gap-2 px-2 @(ng.Id == g.Id ? "itch-neighbor-self" : "")" style="font-size:.82rem">
                                    <span class="itch-num itch-muted" style="width:36px">#@np</span>
                                    <MudLink Href="@($"/games/{ng.Id}")" Class="text-truncate" Style="flex:1;min-width:0">@ng.Title</MudLink>
                                    <span class="itch-num itch-muted">@Fmt.N(ng.Ratings)</span>
                                </div>
                            }
                        </div>
                    }
                </MudPaper>

                <MudPaper Class="pa-4 mb-3" Outlined="true">
                    <div class="itch-section-title">
                        @Txt.S("Оценка аудитории", "Audience estimate")
                        <FormulaTip Title="@Formulas.Audience.Title" Formula="@Formulas.Audience.Formula" Text="@Formulas.Audience.Text" />
                    </div>
                    <table class="itch-kv">
                        <tr><td>@Txt.S("Просмотры страницы", "Page views")</td><td>≈ @Fmt.Short(_vm.Audience.Views) <span class="itch-muted">(@Fmt.Short(_vm.Audience.ViewsLow)–@Fmt.Short(_vm.Audience.ViewsHigh))</span></td></tr>
                        @if (_vm.Audience.BrowserPlays is { } plays)
                        {
                            <tr><td>@Txt.S("Запуски в браузере", "Browser plays")</td><td>≈ @Fmt.Short(plays)</td></tr>
                        }
                        @if (_vm.Audience.Downloads is { } dl)
                        {
                            <tr><td>@Txt.S("Скачивания", "Downloads")</td><td>≈ @Fmt.Short(dl)</td></tr>
                        }
                    </table>
                    <MudText Typo="Typo.caption" Class="itch-muted">
                        @(_vm.Audience.Calibrated
                            ? Txt.S("Коэффициенты откалиброваны по вашим играм (раздел «Моя игра»).", "The ratios are calibrated from your games (My game).")
                            : Txt.S("Грубая оценка по типичной доле оценивающих. Для точности откалибруйте по своим играм в разделе «Моя игра».", "A rough estimate from a typical share of people who rate. Calibrate it from your own games in My game."))
                    </MudText>
                </MudPaper>

                <MudPaper Class="pa-4 mb-3" Outlined="true">
                    <div class="itch-section-title">@Txt.S("Теги", "Tags")</div>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var t in _vm.Tags)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Href="@($"/tags/{Uri.EscapeDataString(t.Slug)}")">@Segments.DisplayName(t)</MudChip>
                        }
                    </div>
                </MudPaper>

                @if (_jams.Count > 0)
                {
                    <MudPaper Class="pa-4" Outlined="true">
                        <div class="itch-section-title">@Txt.S("Джемы", "Jams")</div>
                        @foreach (var j in _jams)
                        {
                            <div class="d-flex align-center py-1 gap-2">
                                <MudLink Href="@($"/jams/{j.Jam.Id}")" Class="text-truncate" Style="flex:1;min-width:0">@j.Jam.Title</MudLink>
                                <span class="itch-muted" style="font-size:.8rem">@Fmt.Date(j.Jam.EndAt)</span>
                                @if (j.Entry.JamRatingCount is { } jr)
                                {
                                    <span class="itch-num" style="font-size:.8rem">@Txt.S($"{Fmt.Count(jr, "оценка", "оценки", "оценок")} на джеме", $"{Fmt.N(jr)} {(jr == 1 ? "rating" : "ratings")} in the jam")</span>
                                }
                            </div>
                        }
                    </MudPaper>
                }
            </MudItem>
        </MudGrid>
    }
</DataGate>

@code {
    [Parameter] public long Id { get; set; }

    private sealed record SegmentPlace(SegmentStats Stats, int Rank, double? Better);

    private sealed record Vm(
        GameRow Game,
        DeveloperRow? Developer,
        AudienceEstimate Audience,
        double? GlobalBetter,
        List<ListPosition> Positions,
        List<SegmentPlace> Segments,
        List<(GameRow Game, double Similarity)> Similar,
        List<ChartSeries> History,
        List<TagRow> Tags);

    private Vm? _vm;
    private long _loadedId = -1;
    private Game? _entity;
    private List<GameSnapshot> _history = [];
    private List<GameJamEntry> _jams = [];
    private Dictionary<string, int> _bestPositions = [];

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id) return;
        _loadedId = Id;
        _entity = await Queries.GameAsync(Id);
        _history = await Queries.GameHistoryAsync(Id);
        _jams = await Queries.GameJamsAsync(Id);
        var positions = await Queries.PositionHistoryAsync(Id);
        _bestPositions = positions.GroupBy(p => p.ListKey).ToDictionary(x => x.Key, x => x.Min(p => p.Position));
        await RecomputeAsync();
    }

    private async Task TrackAsync()
    {
        if (_vm is null) return;
        await Queries.AddTrackedAsync(_vm.Game.Url, isOwn: false, maxPages: 5, note: null);
        Snackbar.Add(Txt.S("Игра добавлена в отслеживание — позиции появятся в разделе «Моя игра».", "The game is now tracked — positions will show up in My game."), Severity.Success);
    }

    protected override void Compute()
    {
        if (!D.GamesById.TryGetValue(Id, out var g) || !F.Includes(g))
        {
            _vm = null;
            return;
        }

        var all = A.All(F);
        var ratedAll = A.Games(F).Where(x => x.Ratings > 0).Select(x => (double)x.Ratings).Order().ToArray();
        double? globalBetter = all.Denominator > 0
            ? Math.Min(1, (Math.Max(0, all.Denominator - ratedAll.Length) + Stats.PercentRank(ratedAll, g.Ratings) * ratedAll.Length) / all.Denominator)
            : null;

        var places = new List<SegmentPlace>();
        foreach (var s in A.SegmentsOf(F, g).Where(x => x.Known >= 10))
        {
            var rated = Segments.Members(D, s.Segment, F).Where(x => x.Ratings > 0).Select(x => (double)x.Ratings).Order().ToArray();
            var rank = rated.Count(r => r > g.Ratings) + 1;
            double? better = s.TotalItch is { } total && total >= rated.Length && total > 0
                ? (total - rated.Length + Stats.PercentRank(rated, g.Ratings) * rated.Length) / total
                : null;
            places.Add(new SegmentPlace(s, rank, better));
        }
        places = places.OrderBy(p => p.Stats.SmallSample ? 1 : 0)
            .ThenBy(p => p.Stats.Segment.Kind == SegmentKind.Genre ? 0 : 1)
            .ThenByDescending(p => p.Stats.Denominator).ToList();

        var similar = new List<(GameRow, double)>();
        if (g.TagIds.Length >= 2)
        {
            foreach (var other in A.Games(F))
            {
                if (other.Id == g.Id || other.TagIds.Length < 2) continue;
                var shared = Shared(g.TagIds, other.TagIds);
                if (shared < 2) continue;
                similar.Add((other, (double)shared / (g.TagIds.Length + other.TagIds.Length - shared)));
            }
            similar = similar.OrderByDescending(x => x.Item2).ThenByDescending(x => x.Item1.Ratings).Take(12).ToList();
        }

        var history = new List<ChartSeries>
        {
            new(Txt.S("Оценок", "Ratings"), _history.Where(h => h.RatingCount is not null).Select(h => new ChartPoint(Fmt.Date(h.Day), h.RatingCount!.Value)).ToList(), ChartKind.Line, Color: ItchTheme.Accent),
            new(Txt.S("Комментариев", "Comments"), _history.Where(h => h.CommentsCount is not null).Select(h => new ChartPoint(Fmt.Date(h.Day), h.CommentsCount!.Value)).ToList(), ChartKind.Line, SecondAxis: true, Color: "#5CC8FA"),
        };

        var tags = g.TagIds.Select(id => D.Tags.GetValueOrDefault(id)).OfType<TagRow>()
            .OrderBy(t => t.Kind).ThenByDescending(t => D.Members(t.Id).Count).ToList();

        _vm = new Vm(g, g.DeveloperId is { } dev ? D.Developers.GetValueOrDefault(dev) : null, Audience.Estimate(g, A.Params), globalBetter,
            Positions.For(D, g.Id), places, similar, history, tags);
    }

    private string ListLabel(string listKey)
    {
        if (listKey == "popular") return Txt.S("Популярное (весь itch.io)", "Popular (all of itch.io)");
        if (listKey == "new-and-popular") return Txt.S("Новое и популярное", "New and popular");
        var slash = listKey.IndexOf('/');
        if (slash < 0) return listKey;
        var filter = listKey[(slash + 1)..];
        var prefix = listKey[..slash] switch
        {
            "popular" => Txt.S("Популярное", "Popular"),
            "new-and-popular" => Txt.S("Новое и популярное", "New and popular"),
            "top-rated" => Txt.S("Лучшие по оценкам", "Top rated"),
            _ => listKey[..slash],
        };
        var names = filter.Split('/').Select(f => D.Tag(f) is { } t ? Segments.DisplayName(t) : ItchCatalog.NameFromSlug(f));
        return $"{prefix}: {string.Join(" + ", names)}";
    }

    private static int Shared(int[] a, int[] b)
    {
        int i = 0, j = 0, n = 0;
        while (i < a.Length && j < b.Length)
        {
            if (a[i] == b[j]) { n++; i++; j++; }
            else if (a[i] < b[j]) i++;
            else j++;
        }
        return n;
    }
}
