@page "/Error"
@using System.Diagnostics

<PageTitle>@Txt.S("Ошибка", "Error")</PageTitle>

<h1 class="text-danger">@Txt.S("Ошибка.", "Error.")</h1>
<h2 class="text-danger">@Txt.S("При обработке запроса произошла ошибка.", "An error occurred while processing your request.")</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@Txt.S("Идентификатор запроса:", "Request ID:")</strong> <code>@RequestId</code>
    </p>
}

<h3>@Txt.S("Режим разработки", "Development Mode")</h3>
<p>
    @Txt.S("В среде Development на экране будет больше подробностей об ошибке.", "Swapping to the Development environment will display more detailed information about the error that occurred.")
</p>
<p>
    <strong>@Txt.S("Не включайте среду Development на развёрнутом приложении.", "The Development environment shouldn't be enabled for deployed applications.")</strong>
    @Txt.S("Иначе пользователи могут увидеть служебные данные из исключений. Для локальной отладки задайте переменную ASPNETCORE_ENVIRONMENT значение Development и перезапустите приложение.", "It can result in displaying sensitive information from exceptions to end users. For local debugging, enable the Development environment by setting the ASPNETCORE_ENVIRONMENT environment variable to Development and restarting the app.")
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
