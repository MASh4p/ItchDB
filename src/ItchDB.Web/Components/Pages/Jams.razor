@page "/jams"
@inherits AnalyticsPage
@inject DataQueries Queries

<PageTitle>@Txt.S("Джемы", "Jams") — ItchDB</PageTitle>

<MudText Typo="Typo.h4">@Txt.S("Джемы", "Jams")</MudText>
<MudText Class="itch-muted mb-3">
    @Txt.S("Джемы — быстрый способ получить первых игроков и оценки. Здесь видно, какие джемы крупные, сколько участников доходит до сдачи и как игры с джемов живут потом.",
           "Jams are a fast way to get the first players and ratings. This shows which jams are large, how many participants finish a game, and how jam games do afterwards.")
</MudText>

<DataGate Snapshot="A" Busy="Computing" Error="@ComputeError">
    @if (_vm is { } vm)
    {
        @if (vm.Rows.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
                @Txt.S("Джемов в базе пока нет. Их собирает ежедневный сбор (список джемов и участники нескольких крупных джемов за раз).",
                       "No jams in the database yet. The daily crawl collects them (the jam list, plus entries from a few large jams each run).")
            </MudAlert>
        }
        <MudGrid Spacing="3" Class="mb-1">
            <MudItem xs="6" md="2">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="@Txt.S("Джемов в базе", "Jams in the database")" Value="@Fmt.N(vm.Rows.Count)" Large="true" Hint="@Txt.S($"с участниками: {Fmt.N(vm.WithEntries)}", $"with entries: {Fmt.N(vm.WithEntries)}")" />
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="2">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="@Txt.S("Идут сейчас", "Live now")" Value="@Fmt.N(vm.Active)" Large="true" Hint="@Txt.S($"скоро начнутся: {Fmt.N(vm.Upcoming)}", $"starting soon: {Fmt.N(vm.Upcoming)}")" Color="#4CC38A" />
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="2">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="@Txt.S("Медиана работ", "Median submissions")" Value="@Fmt.N(vm.MedianSubmissions, 0)" Large="true" Hint="@Txt.S("на джем", "per jam")" />
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="2">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="@Txt.S("Доходят до сдачи", "Finish a submission")" Value="@Fmt.Pct(vm.MedianConversion)" Large="true" Hint="@Txt.S("медиана: работ / записавшихся", "median: submissions / joined")"
                         Tip="@Txt.S("Сколько записавшихся участников в итоге сдают игру. Большинство записавшихся не доходят до конца.", "How many people who joined actually submit a game. Most who join do not finish.")" />
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="2">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="@Txt.S("Игр с джемов", "Games from jams")" Value="@Fmt.N(vm.JamGames)" Large="true" Hint="@Txt.S($"медиана оценок {Fmt.N(vm.JamMedian, 0)} против {Fmt.N(vm.OtherMedian, 0)}", $"median ratings {Fmt.N(vm.JamMedian, 0)} vs {Fmt.N(vm.OtherMedian, 0)}")"
                         Tip="@Txt.S("Игры, сделанные на джем, из общей базы: сравнение медианы оценок на itch.io с остальными играми.", "Jam games from the whole database: median itch.io ratings compared with the other games.")" />
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="2">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="@Txt.S($"Шанс {A.Params.SuccessThreshold}+ у игр с джемов", $"Chance of {A.Params.SuccessThreshold}+ for jam games")" Value="@Fmt.Pct(vm.JamSuccess, 1)" Large="true"
                         Hint="@Txt.S($"у остальных {Fmt.Pct(vm.OtherSuccess, 1)} · среди известных игр", $"other games {Fmt.Pct(vm.OtherSuccess, 1)} · among known games")" />
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudTable T="JamRow" Items="vm.Rows" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" RowsPerPage="50" SortLabel="@Txt.SortLabel"
                  Class="itch-table mt-3" Elevation="0" Filter="Matches">
            <ToolBarContent>
                <MudText Typo="Typo.h6">@Txt.S("Список джемов", "Jam list")</MudText>
                <MudSpacer />
                <MudChipSet T="string" @bind-SelectedValue="_state" SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Size="Size.Small"
                            SelectedColor="Color.Primary" Variant="Variant.Outlined" Class="mr-2">
                    <MudChip T="string" Value="@("all")" Text="@Txt.S("Все", "All")" />
                    <MudChip T="string" Value="@("active")" Text="@Txt.S("Идут", "Live")" />
                    <MudChip T="string" Value="@("upcoming")" Text="@Txt.S("Скоро", "Soon")" />
                    <MudChip T="string" Value="@("ended")" Text="@Txt.S("Прошли", "Ended")" />
                </MudChipSet>
                <MudTextField T="string" @bind-Value="_search" Placeholder="@Txt.SearchPlaceholder" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true" DebounceInterval="300" Variant="Variant.Outlined" Margin="Margin.Dense" Class="itch-search mr-2" />
                <ExportMenu T="JamRow" Name="jams" Rows="@(() => vm.Rows.Where(Matches))" Columns="ExportColumns" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh><MudTableSortLabel T="JamRow" SortBy="j => j.Jam.Title">@Txt.S("Джем", "Jam")</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="JamRow" SortBy="j => j.Jam.StartAt ?? DateTime.MinValue">@Txt.S("Начало", "Starts")</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="JamRow" SortBy="j => j.Jam.EndAt ?? DateTime.MinValue" InitialDirection="SortDirection.Descending">@Txt.S("Сдача до", "Submit by")</MudTableSortLabel></MudTh>
                <MudTh Style="text-align:right"><MudTableSortLabel T="JamRow" SortBy="j => j.Jam.Joined ?? -1">@Txt.S("Записались", "Joined")</MudTableSortLabel></MudTh>
                <MudTh Style="text-align:right"><MudTableSortLabel T="JamRow" SortBy="j => j.Jam.Submissions ?? -1">@Txt.S("Работ", "Submissions")</MudTableSortLabel></MudTh>
                <MudTh Style="text-align:right"><MudTableSortLabel T="JamRow" SortBy="j => j.Conversion ?? -1">@Txt.S("Сдали", "Finished")</MudTableSortLabel></MudTh>
                <MudTh Style="text-align:right"><MudTableSortLabel T="JamRow" SortBy="j => j.Entries">@Txt.S("В базе", "In database")</MudTableSortLabel></MudTh>
                <MudTh>@Txt.S("Статус", "Status")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@Txt.S("Джем", "Jam")">
                    <MudLink Href="@($"/jams/{context.Jam.Id}")">@context.Jam.Title</MudLink>
                    @if (context.Jam.IsFeatured)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text" Class="ml-1">featured</MudChip>
                    }
                    @if (!string.IsNullOrEmpty(context.Jam.Hosts))
                    {
                        <div class="itch-game-sub">@context.Jam.Hosts</div>
                    }
                </MudTd>
                <MudTd DataLabel="@Txt.S("Начало", "Starts")" Class="itch-num">@Fmt.Date(context.Jam.StartAt)</MudTd>
                <MudTd DataLabel="@Txt.S("Сдача до", "Submit by")" Class="itch-num">@Fmt.Date(context.Jam.EndAt)</MudTd>
                <MudTd DataLabel="@Txt.S("Записались", "Joined")" Class="itch-num" Style="text-align:right">@Fmt.N(context.Jam.Joined)</MudTd>
                <MudTd DataLabel="@Txt.S("Работ", "Submissions")" Class="itch-num" Style="text-align:right">@Fmt.N(context.Jam.Submissions)</MudTd>
                <MudTd DataLabel="@Txt.S("Сдали", "Finished")" Class="itch-num" Style="text-align:right">@Fmt.Pct(context.Conversion)</MudTd>
                <MudTd DataLabel="@Txt.S("В базе", "In database")" Class="itch-num" Style="text-align:right">@(context.Entries > 0 ? Fmt.N(context.Entries) : "—")</MudTd>
                <MudTd DataLabel="@Txt.S("Статус", "Status")">
                    <span style="color:@StateColor(context.State)">@StateName(context.State)</span>
                    @if (context.Jam.IsRanked)
                    {
                        <span class="itch-muted"> · @Txt.S("с оценками", "ranked")</span>
                    }
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager RowsPerPageString="@Txt.RowsLabel" InfoFormat="@Txt.PagerInfo" PageSizeOptions="new[] { 25, 50, 100, 250 }" />
            </PagerContent>
        </MudTable>
    }
</DataGate>

@code {
    public enum JamState { Upcoming, Active, Voting, Ended, Unknown }

    public sealed record JamRow(Jam Jam, int Entries, double? Conversion, JamState State);
    private sealed record Vm(List<JamRow> Rows, int WithEntries, int Active, int Upcoming, double MedianSubmissions, double MedianConversion,
        int JamGames, double JamMedian, double OtherMedian, double JamSuccess, double OtherSuccess);

    private Vm? _vm;
    private List<Jam> _jams = [];
    private Dictionary<int, int> _counts = [];
    private string _state = "all";
    private string? _search;

    protected override async Task OnInitializedAsync()
    {
        _jams = await Queries.JamsAsync();
        _counts = await Queries.JamEntryCountsAsync();
        await base.OnInitializedAsync();
    }

    private bool Matches(JamRow r) =>
        _state switch
        {
            "active" => r.State is JamState.Active or JamState.Voting,
            "upcoming" => r.State == JamState.Upcoming,
            "ended" => r.State == JamState.Ended,
            _ => true,
        }
        && (string.IsNullOrWhiteSpace(_search) || r.Jam.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (r.Jam.Hosts?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));

    public static JamState StateOf(Jam j, DateTime now) => j switch
    {
        { StartAt: { } s } when s > now => JamState.Upcoming,
        { EndAt: { } e } when e > now => JamState.Active,
        { VotingEndAt: { } v } when v > now => JamState.Voting,
        { EndAt: not null } => JamState.Ended,
        _ => JamState.Unknown,
    };

    public static string StateName(JamState s) => s switch
    {
        JamState.Upcoming => CatalogNames.Pick(TextLang.Current, "скоро", "soon"),
        JamState.Active => CatalogNames.Pick(TextLang.Current, "идёт", "live"),
        JamState.Voting => CatalogNames.Pick(TextLang.Current, "голосование", "voting"),
        JamState.Ended => CatalogNames.Pick(TextLang.Current, "завершён", "ended"),
        _ => "—",
    };

    public static string StateColor(JamState s) => s switch
    {
        JamState.Upcoming => "#5CC8FA",
        JamState.Active => "#4CC38A",
        JamState.Voting => "#F5B84A",
        _ => "inherit",
    };

    protected override void Compute()
    {
        var now = DateTime.UtcNow;
        var rows = _jams.Select(j => new JamRow(j, _counts.GetValueOrDefault(j.Id),
            j is { Joined: > 0, Submissions: { } s } ? Math.Min(1, (double)s / j.Joined.Value) : null, StateOf(j, now))).ToList();

        var submissions = Stats.Sorted(rows.Where(r => r.Jam.Submissions is > 0).Select(r => (double)r.Jam.Submissions!.Value));
        var conversions = Stats.Sorted(rows.Where(r => r.Conversion is not null).Select(r => r.Conversion!.Value));

        var games = A.Games(F).ToList();
        var jamGames = games.Where(g => g.IsJamEntry).ToList();
        var other = games.Where(g => !g.IsJamEntry).ToList();
        var jamRated = Stats.QualifiedRatings(jamGames, F.MinRatings);
        var otherRated = Stats.QualifiedRatings(other, F.MinRatings);
        double Share(List<GameRow> list) => list.Count > 0 ? (double)list.Count(g => g.Ratings >= A.Params.SuccessThreshold) / list.Count : double.NaN;

        _vm = new Vm(rows, rows.Count(r => r.Entries > 0), rows.Count(r => r.State is JamState.Active or JamState.Voting), rows.Count(r => r.State == JamState.Upcoming),
            submissions.Length > 0 ? Stats.Median(submissions) : double.NaN, conversions.Length > 0 ? Stats.Median(conversions) : double.NaN,
            jamGames.Count, jamRated.Length > 0 ? Stats.Median(jamRated) : double.NaN, otherRated.Length > 0 ? Stats.Median(otherRated) : double.NaN,
            Share(jamGames), Share(other));
    }

    private IReadOnlyList<ExportColumn<JamRow>> ExportColumns =>
    [
        new(Txt.S("Джем", "Jam"), r => r.Jam.Title),
        new(Txt.S("Организаторы", "Hosts"), r => r.Jam.Hosts),
        new(Txt.S("Ссылка", "Link"), r => $"{ItchCatalog.BaseUrl}/jam/{r.Jam.Slug}"),
        new(Txt.S("Начало", "Starts"), r => r.Jam.StartAt),
        new(Txt.S("Сдача до", "Submit by"), r => r.Jam.EndAt),
        new(Txt.S("Голосование до", "Voting until"), r => r.Jam.VotingEndAt),
        new(Txt.S("Записались", "Joined"), r => r.Jam.Joined),
        new(Txt.S("Работ", "Submissions"), r => r.Jam.Submissions),
        new(Txt.S("Доля сдавших", "Finish rate"), r => r.Conversion),
        new(Txt.S("Оценок в джеме", "Ratings in the jam"), r => r.Jam.RatingsCount),
        new(Txt.S("Работ в базе", "Entries in the database"), r => r.Entries),
        new(Txt.S("С оценками", "Ranked"), r => r.Jam.IsRanked),
        new("Featured", r => r.Jam.IsFeatured),
        new(Txt.S("Статус", "Status"), r => StateName(r.State)),
    ];
}
