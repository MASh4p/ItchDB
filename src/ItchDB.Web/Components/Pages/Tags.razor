@page "/tags"
@inherits AnalyticsPage

<PageTitle>Теги и жанры — ItchDB</PageTitle>

<MudText Typo="Typo.h4">Теги и жанры</MudText>
<MudText Class="itch-muted mb-3">
    Спрос, конкуренция и шансы каждого сегмента. Медианы считаются по играм с ≥ @F.MinRatings оценками, конкуренция — по счётчику игр на itch.io.
    Клик по названию открывает подробности сегмента.
</MudText>

<DataGate Snapshot="A" Busy="Computing" Error="@ComputeError">
    @if (_vm is { } vm)
    {
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-3">
            <MudTabPanel Text="@($"Жанры · {vm.Genres.Count}")">
                <MudGrid Spacing="3" Class="mb-2">
                    <MudItem xs="12" md="6">
                        <MudPaper Class="pa-4" Outlined="true">
                            <div class="itch-section-title">Спрос: сглаженная медиана оценок</div>
                            <BarChart Items="vm.GenreDemand" Name="Сглаженная медиана" Horizontal="true" Height="420" Decimals="1" Color="#5CC8FA" />
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudPaper Class="pa-4" Outlined="true">
                            <div class="itch-section-title">Конкуренция: игр на itch.io</div>
                            <BarChart Items="vm.GenreSupply" Name="Игр" Horizontal="true" Height="420" Color="#3A3F58" />
                        </MudPaper>
                    </MudItem>
                </MudGrid>
                <SegmentTable Rows="vm.Genres" Params="A.Params" MinRatings="F.MinRatings" ExportName="genres" TrendCohorts="@vm.Cohorts" RowsPerPage="25" />
            </MudTabPanel>
            <MudTabPanel Text="@($"Теги · {vm.Tags.Count}")">
                <SegmentTable Rows="vm.Tags" Params="A.Params" MinRatings="F.MinRatings" ExportName="tags" TrendCohorts="@vm.Cohorts" RowsPerPage="50" HideSmallByDefault="true" />
            </MudTabPanel>
            <MudTabPanel Text="@($"Движки · {vm.Engines.Count}")">
                <SegmentTable Rows="vm.Engines" Params="A.Params" MinRatings="F.MinRatings" ExportName="engines" TrendCohorts="@vm.Cohorts" RowsPerPage="25" />
            </MudTabPanel>
            <MudTabPanel Text="@($"Форматы · {vm.Formats.Count}")">
                <MudText Typo="Typo.body2" Class="itch-muted mb-2">Платформа, цена, длительность, мультиплеер, управление, статус разработки, использование ИИ и джемы.</MudText>
                <SegmentTable Rows="vm.Formats" Params="A.Params" MinRatings="F.MinRatings" ExportName="formats" TrendCohorts="@vm.Cohorts" RowsPerPage="50" />
            </MudTabPanel>
            <MudTabPanel Text="@($"Языки · {vm.Languages.Count}")">
                <SegmentTable Rows="vm.Languages" Params="A.Params" MinRatings="F.MinRatings" ExportName="languages" TrendCohorts="@vm.Cohorts" ShowOpportunity="false" DefaultSortByOpportunity="false" RowsPerPage="25" />
            </MudTabPanel>
            <MudTabPanel Text="Каталог itch.io">
                <MudTable T="TagRow" Items="vm.Catalog" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" RowsPerPage="50" Elevation="0" Class="itch-table"
                          Filter="@(t => string.IsNullOrWhiteSpace(_catalogSearch) || t.Name.Contains(_catalogSearch, StringComparison.OrdinalIgnoreCase) || t.Slug.Contains(_catalogSearch, StringComparison.OrdinalIgnoreCase))">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6">Все теги со страницы itch.io/tags</MudText>
                        <MudText Typo="Typo.caption" Class="itch-muted ml-3">рост — проектов в день между первым и последним снимком каталога</MudText>
                        <MudSpacer />
                        <MudTextField T="string" @bind-Value="_catalogSearch" Placeholder="Поиск" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                      IconSize="Size.Small" Variant="Variant.Outlined" Margin="Margin.Dense" Class="itch-search mr-2" />
                        <ExportMenu T="TagRow" Name="tag-catalog" Rows="@(() => vm.Catalog)" Columns="CatalogColumns" />
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh><MudTableSortLabel T="TagRow" SortBy="t => t.Name">Тег</MudTableSortLabel></MudTh>
                        <MudTh>Тип</MudTh>
                        <MudTh Style="text-align:right"><MudTableSortLabel T="TagRow" SortBy="t => t.ProjectsCount ?? 0" InitialDirection="SortDirection.Descending">Проектов</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right"><MudTableSortLabel T="TagRow" SortBy="t => t.ThisWeekCount ?? 0">За неделю</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right"><MudTableSortLabel T="TagRow" SortBy="t => Trends.ProjectsPerDay(t) ?? double.MinValue">Рост в день</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align:right"><MudTableSortLabel T="TagRow" SortBy="t => D.Members(t.Id).Count">В базе</MudTableSortLabel></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Тег"><MudLink Href="@($"/tags/{Uri.EscapeDataString(context.Slug)}")">@Segments.DisplayName(context)</MudLink></MudTd>
                        <MudTd DataLabel="Тип" Class="itch-muted">@ItchCatalog.KindName(context.Kind)</MudTd>
                        <MudTd DataLabel="Проектов" Class="itch-num" Style="text-align:right">@Fmt.N(context.ProjectsCount)</MudTd>
                        <MudTd DataLabel="За неделю" Class="itch-num" Style="text-align:right">@Fmt.N(context.ThisWeekCount)</MudTd>
                        <MudTd DataLabel="Рост в день" Class="itch-num" Style="text-align:right">@Fmt.N(Trends.ProjectsPerDay(context), 1)</MudTd>
                        <MudTd DataLabel="В базе" Class="itch-num" Style="text-align:right">@Fmt.N(D.Members(context.Id).Count)</MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager RowsPerPageString="Строк:" InfoFormat="{first_item}–{last_item} из {all_items}" PageSizeOptions="new[] { 25, 50, 100, 500 }" />
                    </PagerContent>
                </MudTable>
            </MudTabPanel>
        </MudTabs>
    }
</DataGate>

@code {
    private sealed record Vm(
        List<SegmentStats> Genres,
        List<SegmentStats> Tags,
        List<SegmentStats> Engines,
        List<SegmentStats> Formats,
        List<SegmentStats> Languages,
        List<TagRow> Catalog,
        List<ChartPoint> GenreDemand,
        List<ChartPoint> GenreSupply,
        string Cohorts);

    private Vm? _vm;
    private string? _catalogSearch;

    private static readonly IReadOnlyList<ExportColumn<TagRow>> CatalogColumns =
    [
        new("Тег", t => t.Name),
        new("Слаг", t => t.Slug),
        new("Тип", t => ItchCatalog.KindName(t.Kind)),
        new("Проектов", t => t.ProjectsCount),
        new("За неделю", t => t.ThisWeekCount),
        new("Рост в день", t => Trends.ProjectsPerDay(t)),
        new("Игр в списке тега", t => t.ListingTotal),
        new("Связанные теги", t => string.Join(", ", t.Related)),
    ];

    protected override void Compute()
    {
        var genres = A.Genres(F);
        var nsfwOk = (TagRow t) => F.ShowNsfw || !ItchCatalog.NsfwTags.Contains(t.Slug);
        _vm = new Vm(
            genres,
            A.Tags(F),
            A.Engines(F),
            A.Formats(F),
            A.Languages(F),
            D.Tags.Values.Where(t => t.ProjectsCount is not null && nsfwOk(t)).ToList(),
            genres.Where(s => s.Qualified > 0).OrderByDescending(s => s.AdjMedian).Select(s => new ChartPoint(s.Name, s.AdjMedian)).ToList(),
            genres.OrderByDescending(s => s.Denominator).Select(s => new ChartPoint(s.Name, s.Denominator)).ToList(),
            A.Analyzer(F).TrendCohorts);
    }
}
