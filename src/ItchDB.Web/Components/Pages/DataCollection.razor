        };
    }

    private static string RunStatusName(CrawlRunStatus s) => s switch
    {
        CrawlRunStatus.Running => "идёт",
        CrawlRunStatus.Completed => "завершён",
        CrawlRunStatus.Stopped => "остановлен",
        CrawlRunStatus.Failed => "ошибка",
        CrawlRunStatus.Interrupted => "прерван закрытием",
        _ => s.ToString(),
    };

    private static Color RunColor(CrawlRunStatus s) => s switch
    {
        CrawlRunStatus.Completed => Color.Success,
        CrawlRunStatus.Failed => Color.Error,
        CrawlRunStatus.Running => Color.Info,
        _ => Color.Warning,
    };

    private static string LogClass(Microsoft.Extensions.Logging.LogLevel level) => level switch
    {
        >= Microsoft.Extensions.Logging.LogLevel.Error => "error",
        Microsoft.Extensions.Logging.LogLevel.Warning => "warn",
        _ => "",
    };

    public void Dispose()
    {
        Crawl.Changed -= OnChanged;
        Net.Changed -= OnChanged;
        Settings.Changed -= OnChanged;
        _timer?.Dispose();
    }
}
