@page "/developers"
@inherits AnalyticsPage

<PageTitle>@Txt.S("Разработчики", "Developers") — ItchDB</PageTitle>

<MudText Typo="Typo.h4">@Txt.S("Разработчики", "Developers")</MudText>
<MudText Class="itch-muted mb-3">
    @Txt.S("Авторы игр из базы: у кого больше подписчиков и оценок, кто быстро растёт и как опыт автора связан с успехом его игр.",
           "Authors in the database: who has more followers and ratings, who is growing fast, and how an author's experience relates to how their games do.")
</MudText>

<DataGate Snapshot="A" Busy="Computing" Error="@ComputeError">
    @if (_vm is { } vm)
    {
        <MudGrid Spacing="3" Class="mb-1">
            <MudItem xs="6" md="3">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="@Txt.S("Разработчиков в базе", "Developers in the database")" Value="@Fmt.N(vm.Rows.Count)" Large="true" Hint="@Txt.S($"с известными подписчиками: {Fmt.N(vm.WithFollowers)}", $"with a known follower count: {Fmt.N(vm.WithFollowers)}")" />
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="@Txt.S("Одна игра в базе", "One game in the database")" Value="@Fmt.Pct(vm.SingleGameShare)" Large="true" Hint="@Txt.S("доля авторов", "share of authors")"
                         Tip="@Txt.S("Большинство авторов на itch.io выпускают одну-две игры. В базе видны не все игры автора, только собранные.", "Most itch.io authors release one or two games. The database only includes the games that have been collected, not every game by the author.")" />
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="@Txt.S("Топ-1% авторов", "Top 1% of authors")" Value="@Fmt.Pct(vm.Top1Share)" Large="true" Hint="@Txt.S("всех оценок в базе", "of all ratings in the database")"
                         Tip="@Txt.S("Доля оценок, которая приходится на 1% самых оценённых разработчиков. Показывает, насколько внимание аудитории сосредоточено у немногих.", "Share of ratings that belongs to the 1% of developers with the most ratings. Shows how concentrated the audience is.")" />
                </MudPaper>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="@Txt.S("Медиана подписчиков", "Median followers")" Value="@Fmt.N(vm.MedianFollowers, 0)" Large="true" Hint="@Txt.S("у авторов с известным числом", "among authors with a known count")" />
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="3" Class="mb-1">
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Outlined="true" Style="height:100%">
                    <div class="itch-section-title">
                        @Txt.S("Опыт автора и оценки его игр", "Author experience and ratings")
                        <FormulaTip Title="@Txt.S("Опыт автора", "Author experience")" Formula="@Txt.S("медиана оценок игр, сгруппированных по числу игр автора в базе", "median ratings of games, grouped by how many of the author's games are in the database")"
                                    Text="@Txt.S("Опытные авторы чаще набирают оценки: у них есть подписчики и навык. Но часть их старых игр в базу могла не попасть.", "Experienced authors more often collect ratings: they have followers and skill. Some of their older games may be missing from the database.")" />
                    </div>
                    <MudSimpleTable Dense="true" Elevation="0" Style="background:transparent">
                        <thead><tr><th>@Txt.S("Игр у автора", "Games by the author")</th><th style="text-align:right">@Txt.S("Авторов", "Authors")</th><th style="text-align:right">@Txt.S("Игр", "Games")</th><th style="text-align:right">@Txt.S("Медиана оценок", "Median ratings")</th><th style="text-align:right">@Txt.S($"Шанс {A.Params.SuccessThreshold}+", $"Chance of {A.Params.SuccessThreshold}+")</th></tr></thead>
                        <tbody>
                            @foreach (var b in vm.Experience)
                            {
                                <tr>
                                    <td>@BucketLabel(b.Label)</td>
                                    <td class="itch-num" style="text-align:right">@Fmt.N(b.Developers)</td>
                                    <td class="itch-num" style="text-align:right">@Fmt.N(b.Games)</td>
                                    <td class="itch-num" style="text-align:right"><b>@Fmt.N(b.Median, 0)</b></td>
                                    <td class="itch-num" style="text-align:right">@Fmt.Pct(b.SuccessShare, 1)</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Outlined="true" Style="height:100%">
                    <div class="itch-section-title">@Txt.S("Быстрее всех набирают подписчиков", "Fastest follower growth")</div>
                    @if (vm.Growing.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="itch-muted">
                            @Txt.S("Рост считается по снимкам профилей минимум за неделю. Ежедневный сбор обновляет профили — через несколько дней здесь появятся лидеры.",
                                   "Growth is measured from profile snapshots at least a week apart. The daily crawl updates profiles — leaders show up here after a few days.")
                        </MudText>
                    }
                    @foreach (var d in vm.Growing)
                    {
                        <div class="d-flex align-center py-1 gap-2">
                            <MudLink Href="@($"/developers/{d.Id}")" Style="flex:1">@d.Name</MudLink>
                            <span class="itch-muted itch-num" style="font-size:.82rem">@Txt.S($"{Fmt.N(d.Followers)} подп.", $"{Fmt.N(d.Followers)} followers")</span>
                            <b class="itch-num" style="color:#4CC38A;width:80px;text-align:right">@Fmt.Signed(d.Delta30)</b>
                        </div>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudTable T="DevStat" Items="vm.Rows" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" RowsPerPage="50" SortLabel="@Txt.SortLabel"
                  Class="itch-table mt-3" Elevation="0" Filter="Matches">
            <ToolBarContent>
                <MudText Typo="Typo.h6">@Txt.S("Все разработчики", "All developers")</MudText>
                <MudSpacer />
                <MudTextField T="string" @bind-Value="_search" Placeholder="@Txt.SearchPlaceholder" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true" DebounceInterval="300" Variant="Variant.Outlined" Margin="Margin.Dense" Class="itch-search mr-2" />
                <MudSwitch T="bool" @bind-Value="_onlyWithFollowers" Color="Color.Primary" Label="@Txt.S("С подписчиками", "With followers")" Class="mr-2" />
                <ExportMenu T="DevStat" Name="developers" Rows="@(() => vm.Rows.Where(Matches))" Columns="ExportColumns" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh><MudTableSortLabel T="DevStat" SortBy="d => d.Name">@Txt.S("Разработчик", "Developer")</MudTableSortLabel></MudTh>
                <MudTh Style="text-align:right"><MudTableSortLabel T="DevStat" SortBy="d => d.Followers ?? -1" InitialDirection="SortDirection.Descending">@Txt.S("Подписчики", "Followers")</MudTableSortLabel></MudTh>
                <MudTh Style="text-align:right"><MudTableSortLabel T="DevStat" SortBy="d => d.Delta30 ?? int.MinValue">@Txt.S("За 30 дней", "Last 30 days")</MudTableSortLabel></MudTh>
                <MudTh Style="text-align:right"><MudTableSortLabel T="DevStat" SortBy="d => d.Games">@Txt.S("Игр", "Games")</MudTableSortLabel></MudTh>
                <MudTh Style="text-align:right"><MudTableSortLabel T="DevStat" SortBy="d => d.SumRatings">@Txt.S("Оценок всего", "Ratings total")</MudTableSortLabel></MudTh>
                <MudTh Style="text-align:right"><MudTableSortLabel T="DevStat" SortBy="d => double.IsNaN(d.Median) ? -1 : d.Median">@Txt.S("Медиана", "Median")</MudTableSortLabel></MudTh>
                <MudTh>@Txt.S("Самая оценённая игра", "Highest-rated game")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@Txt.S("Разработчик", "Developer")"><MudLink Href="@($"/developers/{context.Id}")">@context.Name</MudLink></MudTd>
                <MudTd DataLabel="@Txt.S("Подписчики", "Followers")" Class="itch-num" Style="text-align:right">@Fmt.N(context.Followers)</MudTd>
                <MudTd DataLabel="@Txt.S("За 30 дней", "Last 30 days")" Class="itch-num" Style="text-align:right">@Fmt.Signed(context.Delta30)</MudTd>
                <MudTd DataLabel="@Txt.S("Игр", "Games")" Class="itch-num" Style="text-align:right">@Fmt.N(context.Games)</MudTd>
                <MudTd DataLabel="@Txt.S("Оценок", "Ratings")" Class="itch-num" Style="text-align:right">@Fmt.N(context.SumRatings)</MudTd>
                <MudTd DataLabel="@Txt.S("Медиана", "Median")" Class="itch-num" Style="text-align:right">@Fmt.N(context.Median, 0)</MudTd>
                <MudTd DataLabel="@Txt.S("Игра", "Game")">
                    @if (context.Best is { } best)
                    {
                        <MudLink Href="@($"/games/{best.Id}")">@best.Title</MudLink>
                        <span class="itch-muted" style="font-size:.8rem"> · @Fmt.N(best.Ratings)</span>
                    }
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager RowsPerPageString="@Txt.RowsLabel" InfoFormat="@Txt.PagerInfo" PageSizeOptions="new[] { 25, 50, 100, 250 }" />
            </PagerContent>
        </MudTable>
    }
</DataGate>

@code {
    public sealed record DevStat(long Id, string Name, string? Url, int? Followers, int? Delta30, int Games, int Rated, long SumRatings, double Median, GameRow? Best);
    private sealed record ExperienceBucket(string Label, int Developers, int Games, double Median, double SuccessShare);
    private sealed record Vm(List<DevStat> Rows, int WithFollowers, double SingleGameShare, double Top1Share, double MedianFollowers,
        List<ExperienceBucket> Experience, List<DevStat> Growing);

    private Vm? _vm;
    private string? _search;
    private bool _onlyWithFollowers;

    private string BucketLabel(string label) => label switch
    {
        "1 игра" => Txt.S("1 игра", "1 game"),
        "2–4 игры" => Txt.S("2–4 игры", "2–4 games"),
        "5–9 игр" => Txt.S("5–9 игр", "5–9 games"),
        "10+ игр" => Txt.S("10+ игр", "10+ games"),
        _ => label,
    };

    private bool Matches(DevStat d) =>
        (!_onlyWithFollowers || d.Followers is not null)
        && (string.IsNullOrWhiteSpace(_search) || d.Name.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override void Compute()
    {
        var min = F.MinRatings;
        var byDev = A.Games(F).Where(g => g.DeveloperId is not null).GroupBy(g => g.DeveloperId!.Value).ToList();
        var rows = new List<DevStat>(byDev.Count);
        foreach (var grp in byDev)
        {
            var games = grp.ToList();
            D.Developers.TryGetValue(grp.Key, out var dev);
            var rated = Stats.QualifiedRatings(games, min);
            var name = dev?.Name ?? games.Select(g => g.AuthorName).FirstOrDefault(n => !string.IsNullOrEmpty(n)) ?? grp.Key.ToString();
            rows.Add(new DevStat(grp.Key, name, dev?.Url, dev?.Followers, dev?.FollowersDelta30, games.Count, rated.Length,
                games.Sum(g => (long)g.Ratings), rated.Length > 0 ? Stats.Median(rated) : double.NaN,
                games.Where(g => g.Ratings > 0).MaxBy(g => g.Ratings)));
        }

        var followers = Stats.Sorted(rows.Where(r => r.Followers is not null).Select(r => (double)r.Followers!.Value));
        var totalRatings = rows.Sum(r => r.SumRatings);
        var top1 = rows.OrderByDescending(r => r.SumRatings).Take(Math.Max(1, rows.Count / 100)).Sum(r => r.SumRatings);

        (string Label, int From, int To)[] buckets = [("1 игра", 1, 1), ("2–4 игры", 2, 4), ("5–9 игр", 5, 9), ("10+ игр", 10, int.MaxValue)];
        var experience = buckets.Select(b =>
        {
            var groups = byDev.Where(g => g.Count() >= b.From && g.Count() <= b.To).ToList();
            var games = groups.SelectMany(g => g).ToList();
            var rated = Stats.QualifiedRatings(games, min);
            var success = games.Count(g => g.Ratings >= A.Params.SuccessThreshold);
            return new ExperienceBucket(b.Label, groups.Count, games.Count, rated.Length > 0 ? Stats.Median(rated) : double.NaN,
                games.Count > 0 ? (double)success / games.Count : double.NaN);
        }).Where(b => b.Developers > 0).ToList();

        var growing = rows.Where(r => r.Delta30 > 0).OrderByDescending(r => r.Delta30).Take(10).ToList();

        _vm = new Vm(rows, followers.Length, rows.Count > 0 ? (double)rows.Count(r => r.Games == 1) / rows.Count : double.NaN,
            totalRatings > 0 ? (double)top1 / totalRatings : double.NaN, followers.Length > 0 ? Stats.Median(followers) : double.NaN,
            experience, growing);
    }

    private IReadOnlyList<ExportColumn<DevStat>> ExportColumns =>
    [
        new(Txt.S("Разработчик", "Developer"), d => d.Name),
        new(Txt.S("Профиль", "Profile"), d => d.Url),
        new(Txt.S("Подписчики", "Followers"), d => d.Followers),
        new(Txt.S("Подписчиков за 30 дней", "Followers in 30 days"), d => d.Delta30),
        new(Txt.S("Игр в базе", "Games in the database"), d => d.Games),
        new(Txt.S("Игр с оценками", "Games with ratings"), d => d.Rated),
        new(Txt.S("Оценок всего", "Ratings total"), d => d.SumRatings),
        new(Txt.S("Медиана оценок", "Median ratings"), d => double.IsNaN(d.Median) ? null : d.Median),
        new(Txt.S("Самая оценённая игра", "Highest-rated game"), d => d.Best?.Title),
        new(Txt.S("Оценок у неё", "Its ratings"), d => d.Best?.Ratings),
    ];
}
