@page "/developer"
@inherits AnalyticsPage

<PageTitle>@Txt.S("Для разработчика", "For developers") — ItchDB</PageTitle>

<MudText Typo="Typo.h4">@Txt.S("Для разработчика", "For developers")</MudText>
<MudText Class="itch-muted mb-3">
    @Txt.S("Какие игры востребованы, где меньше конкуренции и что сопутствует успеху. Все цифры посчитаны по собранным данным с учётом фильтров в шапке.",
        "Which games find an audience, where competition is thinner, and what goes with success. Every figure uses the collected data and the filters in the bar.")
</MudText>

<DataGate Snapshot="A" Busy="Computing" Error="@ComputeError">
    @if (_vm is { } vm)
    {
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-3" @bind-ActivePanelIndex="_tab">
            <MudTabPanel Text="@Txt.S("Выводы", "Conclusions")" Icon="@Icons.Material.Filled.TipsAndUpdates">
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="7">
                        <MudPaper Class="pa-4" Outlined="true">
                            <div class="itch-section-title">@Txt.S("Выводы по данным", "What the data says")</div>
                            <InsightList Items="vm.Insights" />
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="5">
                        <MudPaper Class="pa-4 mb-3" Outlined="true">
                            <div class="itch-section-title">@Txt.S("От чего зависит число оценок", "What the rating count depends on")</div>
                            @if (vm.Drivers.AgeDoublingMultiplier is { } age)
                            {
                                <div class="itch-insight info">
                                    <b>@Txt.S("Возраст игры.", "Age of the game.")</b> @Txt.S($"При прочих равных игра вдвое старше имеет в {Fmt.Times(age)} больше оценок: оценки копятся годами, поэтому старые хиты сравнивают с новыми только по когортам.",
                                        $"All else equal, a game twice as old has {Fmt.Times(age)} the ratings: ratings accumulate for years, so old hits are compared with new ones only inside a cohort.")
                                </div>
                            }
                            @if (vm.Drivers.ScreenshotsDoublingMultiplier is { } shots)
                            {
                                <div class="itch-insight @(shots > 1.05 ? "good" : "info")">
                                    <b>@Txt.S("Оформление страницы.", "Page presentation.")</b> @Txt.S($"Вдвое больше скриншотов — {Fmt.Times(shots)} к оценкам. Страница — это витрина: обложка, скриншоты и короткое описание решают, откроют ли игру.",
                                        $"Twice as many screenshots is {Fmt.Times(shots)} the ratings. The page is the storefront: cover, screenshots and a short description decide whether the game is opened.")
                                </div>
                            }
                            @foreach (var d in vm.TopDrivers)
                            {
                                <div class="itch-insight @(d.Multiplier > 1 ? "good" : "warn")">
                                    <b>@d.Name</b> <span class="itch-muted">(@d.Group.ToLowerInvariant())</span> — @Txt.S($"{Fmt.Times(d.Multiplier)} к оценкам при прочих равных, шанс {A.Params.SuccessThreshold}+ оценок {Fmt.Pct(d.SuccessWith)} против {Fmt.Pct(d.SuccessWithout)}.",
                                        $"{Fmt.Times(d.Multiplier)} the ratings, all else equal; chance of {A.Params.SuccessThreshold}+ ratings is {Fmt.Pct(d.SuccessWith)} versus {Fmt.Pct(d.SuccessWithout)}.")
                                </div>
                            }
                            @if (vm.Drivers.Sample < 200)
                            {
                                <MudText Typo="Typo.body2" Class="itch-muted">
                                    @Txt.S($"Модели нужно ≥ 200 игр с прочитанными страницами (сейчас {vm.Drivers.Sample}). Полный проход запускается отдельно: «Карточки игр» на странице сбора.",
                                        $"The model needs ≥ 200 games with pages read (currently {vm.Drivers.Sample}). The full pass is started separately: “Game cards” on the collection page.")
                                </MudText>
                            }
                            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => _tab = 5)" EndIcon="@Icons.Material.Filled.ArrowForward">@Txt.S("Все факторы", "All factors")</MudButton>
                        </MudPaper>
                        <MudPaper Class="pa-4" Outlined="true">
                            <div class="itch-section-title">@Txt.S("Как читать показатели", "How to read the figures")</div>
                            <table class="itch-kv" style="font-size:.85rem">
                                <tr><td>@Txt.S("Медиана / среднее", "Median / mean")</td><td>@Txt.S($"сколько оценок набирает игра с ≥ {F.MinRatings} оценками. Медиана часто равна 1–2 и слипает теги; «Среднее» рядом с таблицей и картой учитывает хиты и лучше их разделяет. Оценки ≈ аудитория: оценивает малая доля игроков.", $"how many ratings a game with ≥ {F.MinRatings} ratings collects. The median is often 1–2 and piles tags together; “Mean” next to the table and the map counts hits and separates them better. Ratings ≈ audience: only a small share of players rate a game.")</td></tr>
                                <tr><td>@Txt.S("Шанс успеха", "Success chance")</td><td>@Txt.S($"доля игр сегмента, набравших ≥ {A.Params.SuccessThreshold} оценок. При включённом «0 оценок» знаменатель — весь список itch.io, включая игры без оценок.", $"share of the segment’s games that reached ≥ {A.Params.SuccessThreshold} ratings. With “0 ratings” on, the denominator is the whole itch.io list, including unrated games.")</td></tr>
                                <tr><td>@Txt.S("Конкуренция", "Competition")</td><td>@Txt.S("сколько игр в сегменте. При включённом «0 оценок» — счётчик «(N results)», без скачивания самих игр без оценок.", "how many games are in the segment. With “0 ratings” on, this is the “(N results)” counter, without downloading the unrated games.")</td></tr>
                                <tr><td>@Txt.S("Тренд", "Trend")</td><td>@Txt.S("как меняется доля сегмента среди успешных игр в новых когортах против старых.", "how the segment’s share among successful games changes in newer cohorts versus older ones.")</td></tr>
                                <tr><td>Opportunity</td><td>@Txt.S("0–100: спрос, шанс, низкая конкуренция и рост, взвешенные в настройках.", "0–100: demand, chance, low competition and growth, weighted in settings.")</td></tr>
                                <tr><td>@Txt.S("Квадранты", "Quadrants")</td><td>@Txt.S("спрос выше/ниже медианы × игр больше/меньше медианы.", "demand above/below the median × more/fewer games than the median.")</td></tr>
                            </table>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="@Txt.S("Карта возможностей", "Opportunity map")" Icon="@Icons.Material.Filled.BubbleChart">
                <MudPaper Class="pa-4 mb-3" Outlined="true">
                    <div class="d-flex flex-wrap align-center gap-2 mb-2">
                        <div class="itch-section-title mb-0">
                            @Txt.S("Спрос против конкуренции", "Demand versus competition")
                            <FormulaTip Title="@Formulas.Quadrant.Title" Formula="@Formulas.Quadrant.Formula" Text="@Formulas.Quadrant.Text" />
                        </div>
                        <MudSpacer />
                        <SegmentFilters ShowHideSwitch="false" />
                        <MudChipSet T="string" @bind-SelectedValue="_mapSet" @bind-SelectedValue:after="OnMapSetChanged" SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Size="Size.Small" SelectedColor="Color.Primary" Variant="Variant.Outlined">
                            <MudChip T="string" Value="@("tags")" Text="@Txt.S("Теги", "Tags")" />
                            <MudChip T="string" Value="@("genres")" Text="@Txt.S("Жанры", "Genres")" />
                            <MudChip T="string" Value="@("formats")" Text="@Txt.S("Форматы", "Formats")" />
                            <MudChip T="string" Value="@("all")" Text="@Txt.S("Всё вместе", "All together")" />
                        </MudChipSet>
                    </div>
                    <OpportunityMap Items="vm.MapItems" Threshold="A.Params.SuccessThreshold" MinRatings="F.MinRatings"
                                    MinGames="Ui.SmallGameThreshold" UseMean="Ui.DemandUsesMean" />
                </MudPaper>
                <MudGrid Spacing="3">
                    @foreach (var (quadrant, items) in vm.ByQuadrant)
                    {
                        <MudItem xs="12" sm="6" lg="3">
                            <MudPaper Class="pa-4 itch-card" Outlined="true" Style="@($"border-top:3px solid {QuadrantChip.Color(quadrant)}")">
                                <MudText Typo="Typo.subtitle1" Style="@($"color:{QuadrantChip.Color(quadrant)};font-weight:700")">@SegmentAnalyzer.QuadrantName(quadrant)</MudText>
                                <MudText Typo="Typo.caption" Class="itch-muted d-block mb-2">@SegmentAnalyzer.QuadrantHint(quadrant)</MudText>
                                @foreach (var s in items)
                                {
                                    <div class="d-flex align-center py-1" style="font-size:.86rem">
                                        <MudLink Href="@($"/tags/{Uri.EscapeDataString(s.Key)}")" Class="text-truncate" Style="flex:1;min-width:0">@s.Name</MudLink>
                                        <span class="itch-muted mr-2">@Fmt.N(Ui.DemandUsesMean ? s.Mean : s.Median, Ui.DemandUsesMean ? 1 : 0)</span>
                                        <b class="itch-num">@Fmt.N(s.Opportunity, 0)</b>
                                    </div>
                                }
                                @if (items.Count == 0)
                                {
                                    <MudText Typo="Typo.body2" Class="itch-muted">@Txt.S("Нет сегментов.", "No segments.")</MudText>
                                }
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="@Txt.S("Ниши", "Niches")" Icon="@Icons.Material.Filled.Leaderboard">
                <SegmentTable Rows="vm.Niches" Params="A.Params" MinRatings="F.MinRatings" Title="@Txt.S("Рейтинг ниш: жанры и теги", "Niche ranking: genres and tags")" ExportName="niches"
                              TrendCohorts="@vm.Cohorts" RowsPerPage="50" HideSmallByDefault="true" />
            </MudTabPanel>

            <MudTabPanel Text="@Txt.S("Форматы", "Formats")" Icon="@Icons.Material.Filled.Devices">
                <MudGrid Spacing="3" Class="mb-2">
                    @foreach (var group in vm.FormatGroups)
                    {
                        <MudItem xs="12" md="6" lg="4">
                            <MudPaper Class="pa-4 itch-card" Outlined="true">
                                <div class="itch-section-title">@group.Title</div>
                                <MudSimpleTable Dense="true" Elevation="0" Style="background:transparent">
                                    <thead><tr><th></th><th style="text-align:right">@(Ui.DemandUsesMean ? Txt.S("Среднее", "Mean") : Txt.S("Медиана", "Median"))</th><th style="text-align:right">@Txt.S("Шанс", "Chance")</th><th style="text-align:right">@Txt.S("к itch.io", "vs itch.io")</th></tr></thead>
                                    <tbody>
                                        @foreach (var s in group.Items)
                                        {
                                            var ratio = vm.All.SuccessShare > 0 ? s.SuccessShare / vm.All.SuccessShare : double.NaN;
                                            <tr>
                                                <td><MudLink Href="@($"/tags/{Uri.EscapeDataString(s.Key)}")">@s.Name</MudLink></td>
                                                <td class="itch-num" style="text-align:right">@Fmt.N(Ui.DemandUsesMean ? s.Mean : s.Median, Ui.DemandUsesMean ? 1 : 0)</td>
                                                <td class="itch-num" style="text-align:right">@(s.DenominatorEstimated ? "≈ " : "")@Fmt.Pct(s.SuccessShare, 1)</td>
                                                <td class="itch-num" style="text-align:right;color:@(ratio >= 1.2 ? "#4CC38A" : ratio <= 0.8 ? "#FF8A8A" : "inherit")">@Fmt.Times(ratio)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
                <SegmentTable Rows="vm.Formats" Params="A.Params" MinRatings="F.MinRatings" Title="@Txt.S("Все форматы", "All formats")" ExportName="formats" TrendCohorts="@vm.Cohorts" RowsPerPage="50" HideSmallByDefault="true" />
            </MudTabPanel>

            <MudTabPanel Text="@Txt.S("Сочетания тегов", "Tag combinations")" Icon="@Icons.Material.Filled.JoinInner">
                <CombosTab Combos="vm.Combos" MinRatings="F.MinRatings" SuccessThreshold="A.Params.SuccessThreshold" />
            </MudTabPanel>

            <MudTabPanel Text="@Txt.S("Факторы успеха", "Success factors")" Icon="@Icons.Material.Filled.Insights">
                <DriversTab Report="vm.Drivers" MinRatings="F.MinRatings" SuccessThreshold="A.Params.SuccessThreshold" />
            </MudTabPanel>

            <MudTabPanel Text="@Txt.S("Проверка идеи", "Idea check")" Icon="@Icons.Material.Filled.Lightbulb">
                <ConceptTab Snapshot="A" Filter="F" InitialTags="@Tags" InitialGenre="@Genre" AutoRun="@(!string.IsNullOrEmpty(Tags) || !string.IsNullOrEmpty(Genre))" />
            </MudTabPanel>
        </MudTabs>
    }
</DataGate>

@code {
    private static readonly string[] TabKeys = ["insights", "map", "niches", "formats", "combos", "drivers", "concept"];

    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    [SupplyParameterFromQuery(Name = "tags")] public string? Tags { get; set; }
    [SupplyParameterFromQuery(Name = "genre")] public string? Genre { get; set; }

    private sealed record FormatGroup(string Title, List<SegmentStats> Items);

    private sealed record Vm(
        SegmentStats All,
        List<Insight> Insights,
        DriversReport Drivers,
        List<DriverResult> TopDrivers,
        List<SegmentStats> MapItems,
        List<(Quadrant Quadrant, List<SegmentStats> Items)> ByQuadrant,
        List<SegmentStats> Niches,
        List<SegmentStats> Formats,
        List<FormatGroup> FormatGroups,
        List<TagComboResult> Combos,
        string Cohorts);

    private Vm? _vm;
    private int _tab;
    private string? _appliedTab;
    private string _mapSet = "tags";

    protected override void OnParametersSet()
    {
        if (Tab != _appliedTab)
        {
            _appliedTab = Tab;
            var index = Array.IndexOf(TabKeys, Tab ?? "");
            if (index >= 0) _tab = index;
        }
    }

    private Task OnMapSetChanged() => RecomputeAsync();

    protected override void Compute()
    {
        var all = A.All(F);
        var useMean = Ui.DemandUsesMean;
        var minGames = Ui.SmallGameThreshold;
        var genres = SegmentAnalyzer.WithDemand(A.Genres(F), A.Params, useMean);
        var tags = SegmentAnalyzer.WithDemand(A.Tags(F), A.Params, useMean);
        var formats = SegmentAnalyzer.WithDemand(A.Formats(F), A.Params, useMean);
        var drivers = A.Drivers(F);

        var topDrivers = drivers.Results.Where(r => r.Multiplier is not null && r.Significant && r.Group is not ("Витрина" or "Storefront"))
            .OrderByDescending(r => Math.Abs(Math.Log(r.Multiplier!.Value))).Take(6).ToList();

        var mapSource = _mapSet switch
        {
            "genres" => genres,
            "formats" => formats,
            "all" => genres.Concat(tags).Concat(formats).ToList(),
            _ => tags,
        };
        var mapItems = mapSource
            .Where(s => s.Qualified >= minGames && s.Denominator > 0)
            .Select(s => s.Clone())
            .ToList();
        SegmentAnalyzer.Rank(mapItems, A.Params, byMean: useMean, minQualified: minGames);
        mapItems = mapItems.Where(s => s.Opportunity is not null && (useMean ? s.AdjMean : s.Typical) > 0).ToList();

        var byQuadrant = new[] { Quadrant.BlueOcean, Quadrant.RedOcean, Quadrant.QuietNiche, Quadrant.Trap }
            .Select(q => (q, mapItems.Where(s => s.Quadrant == q).OrderByDescending(s => s.Opportunity).Take(8).ToList()))
            .ToList();

        var niches = genres.Concat(tags).OrderByDescending(s => s.Opportunity ?? -1).ToList();

        var groups = formats.GroupBy(s => s.Segment.Kind)
            .Select(g => new FormatGroup(Segments.KindName(g.Key), g.Where(s => s.Known > 0 && s.Qualified >= minGames).OrderByDescending(s => s.SuccessShare).ToList()))
            .Where(g => g.Items.Count > 0)
            .ToList();

        _vm = new Vm(all, A.Insights(F), drivers, topDrivers, mapItems, byQuadrant, niches, formats, groups, A.Combos(F), A.Analyzer(F).TrendCohorts);
    }
}
