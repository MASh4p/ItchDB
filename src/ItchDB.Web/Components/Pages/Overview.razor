@page "/"
@inherits AnalyticsPage

<PageTitle>@Txt.S("Обзор", "Overview") — ItchDB</PageTitle>

<MudText Typo="Typo.h4">@Txt.S("Обзор", "Overview")</MudText>
<MudText Class="itch-muted mb-4">
    @Txt.S("Состояние itch.io по собранным данным. Все цифры учитывают фильтры «18+», «0 оценок» и «Мин. оценок» в шапке.",
        "itch.io as collected. Every figure follows the 18+, 0 ratings and minimum-ratings filters in the bar.")
</MudText>

<DataGate Snapshot="A" Busy="Computing" Error="@ComputeError">
    @if (_vm is { } vm)
    {
        @if (D.YearsTotal > 0 && D.YearsComplete < D.YearsTotal)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-4">
                @Txt.S($"Оценённые игры собраны полностью за {D.YearsComplete} из {D.YearsTotal} лет — медианы и доли пока смещены к популярным играм.",
                    $"Rated games are fully collected for {D.YearsComplete} of {D.YearsTotal} years — medians and shares still lean toward popular games.")
                @Txt.S("Запустите", "Start a") <MudLink Href="/data">@Txt.S("глубокий сбор", "deep collection")</MudLink>@Txt.S(", он продолжит с места остановки.", "; it continues from where it stopped.")
            </MudAlert>
        }

        <MudGrid Spacing="3" Class="mb-2">
            <MudItem xs="6" sm="4" md="3" lg="2">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="@Txt.S("Игр на itch.io", "Games on itch.io")" Value="@Fmt.Short(D.CatalogTotal)" Large="true"
                         Hint="@Txt.S($"в базе {Fmt.N(vm.Known)}", $"in the database {Fmt.N(vm.Known)}")"
                         Tip="@Txt.S("Счётчик «(N results)» списка всех игр itch.io; в базе — сколько из них уже собрано.", "The “(N results)” counter of the full itch.io game list; in the database is how many of them are collected.")" />
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="4" md="3" lg="2">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="@Txt.S("Без единой оценки", "No ratings at all")" Value="@Fmt.Pct(vm.ZeroShare)" Large="true" Color="#F5B84A"
                         Hint="@Txt.S("доля игр каталога", "share of the catalog")"
                         Formula="@Txt.S("(игр на itch.io − игр с оценками) / игр на itch.io", "(games on itch.io − rated games) / games on itch.io")"
                         Tip="@Txt.S("Большинство игр никто не оценивает. Поэтому медианы считаются только по играм с оценками выше порога.", "Most games are never rated. Medians therefore use only games above the ratings threshold.")" />
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="4" md="3" lg="2">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="@(Ui.DemandUsesMean ? Txt.S("Среднее оценок", "Mean ratings") : Txt.S("Медиана оценок", "Median ratings"))" Value="@Fmt.N(Ui.DemandUsesMean ? vm.All.Mean : vm.All.Median, Ui.DemandUsesMean ? 1 : 0)" Large="true"
                         Hint="@Txt.S($"по {Fmt.N(vm.All.Qualified)} играм с ≥ {F.MinRatings}", $"across {Fmt.N(vm.All.Qualified)} games with ≥ {F.MinRatings}")"
                         Formula="@(Ui.DemandUsesMean ? Formulas.Mean(F.MinRatings).Formula : Formulas.Median(F.MinRatings).Formula)"
                         Tip="@(Ui.DemandUsesMean ? Formulas.Mean(F.MinRatings).Text : Formulas.Median(F.MinRatings).Text)" />
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="4" md="3" lg="2">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="@Txt.S("Лучшие 10%", "Top 10%")" Value="@($"{Fmt.N(vm.All.P90, 0)}+")" Large="true" Hint="@Txt.S("оценок (P90)", "ratings (P90)")"
                         Formula="@Formulas.Quantiles.Formula" Tip="@Formulas.Quantiles.Text" />
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="4" md="3" lg="2">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="@Txt.S($"Шанс {A.Params.SuccessThreshold}+ оценок", $"Chance of {A.Params.SuccessThreshold}+ ratings")" Value="@Fmt.Pct(vm.All.SuccessShare, 1)" Large="true" Color="#4CC38A"
                         Hint="@($"95%: {Fmt.Pct(vm.All.SuccessLow, 1)}–{Fmt.Pct(vm.All.SuccessHigh, 1)}")"
                         Formula="@Formulas.Success(A.Params.SuccessThreshold).Formula" Tip="@Formulas.Success(A.Params.SuccessThreshold).Text" />
                </MudPaper>
            </MudItem>
            <MudItem xs="6" sm="4" md="3" lg="2">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <Kpi Label="@Txt.S("Средняя оценка", "Average rating")" Value="@Fmt.Stars(vm.All.MedianStars)" Large="true"
                         Hint="@Txt.S("медиана среди игр с оценками", "median among rated games")"
                         Tip="@Txt.S("Звёзды почти не различают игры: у большинства заметных игр 4–5★. Спрос лучше видно по числу оценок.", "Stars barely separate games: most visible ones sit at 4–5★. Demand shows up better in the rating count.")" />
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="3">
            <MudItem xs="12" md="5">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <div class="itch-section-title">@Txt.S("Главные выводы", "Main conclusions")</div>
                    <InsightList Items="vm.Insights" Max="7" />
                    <MudButton Href="/developer" Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward">
                        @Txt.S("Все выводы для разработчика", "All conclusions for developers")
                    </MudButton>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="7">
                <MudPaper Class="pa-4 mb-3" Outlined="true">
                    <div class="itch-section-title">
                        @Txt.S("Сколько оценок набирают игры", "How many ratings games collect")
                        <FormulaTip Title="@Txt.S("Распределение", "Distribution")" Text="@Txt.S("Столбец «0» — оценка по счётчику itch.io (все игры каталога минус игры с оценками), остальные — по собранным играм.", "The “0” bar is estimated from the itch.io counter (every catalog game minus rated games); the rest use collected games.")" />
                    </div>
                    <BarChart Items="vm.Distribution" Name="@Txt.S("Игр", "Games")" Height="260" Logarithmic="true" />
                </MudPaper>
                <MudPaper Class="pa-4" Outlined="true">
                    <div class="itch-section-title">
                        @Txt.S("По годам выхода", "By release year")
                        <FormulaTip Title="@Txt.S("Когорты по годам", "Year cohorts")" Text="@Txt.S("Линия — среднее число оценок у игр с порогом из шапки. Медиана года почти всегда 1 или 2 и не различает когорты. Старые игры успели накопить больше оценок, поэтому сравнивайте форму, а не уровни.", "The line is the mean rating count for games at the bar’s threshold. A year’s median is almost always 1 or 2 and does not separate cohorts. Older games have had longer to collect ratings, so compare the shape, not the levels.")" />
                    </div>
                    <SeriesChart Series="vm.Years" Height="280" LeftTitle="@Txt.S("Игр", "Games")" RightTitle="@Txt.S("Среднее оценок", "Mean ratings")" />
                    @if (vm.WithYear < vm.Known * 0.8)
                    {
                        <MudText Typo="Typo.caption" Class="itch-muted">
                            @Txt.S($"Год выхода известен у {Fmt.N(vm.WithYear)} из {Fmt.N(vm.Known)} игр в базе. Остальные годы появятся после глубокого сбора (списки по годам и страницы игр).",
                                $"Release year is known for {Fmt.N(vm.WithYear)} of {Fmt.N(vm.Known)} games in the database. The rest appear after a deep collection (year lists and game pages).")
                        </MudText>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="3" Class="mt-1">
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 itch-card" Outlined="true">
                    <div class="itch-section-title">
                        @Txt.S("Жанры: спрос", "Genres: demand")
                        <FormulaTip Title="@(Ui.DemandUsesMean ? Formulas.AdjMean.Title : Formulas.AdjMedian.Title)"
                                    Formula="@(Ui.DemandUsesMean ? Formulas.AdjMean.Formula : Formulas.AdjMedian.Formula)"
                                    Text="@(Ui.DemandUsesMean ? Formulas.AdjMean.Text : Formulas.AdjMedian.Text)" />
                    </div>
                    <BarChart Items="vm.Genres" Name="@(Ui.DemandUsesMean ? Txt.S("Сглаженное среднее", "Smoothed mean") : Txt.S("Сглаженная медиана", "Smoothed median"))" Horizontal="true" Height="440" Decimals="1" Color="#5CC8FA" />
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 mb-3" Outlined="true">
                    <div class="d-flex align-center">
                        <div class="itch-section-title">@Txt.S("Лучшие ниши сейчас", "Best niches right now")</div>
                        <MudSpacer />
                        <MudLink Href="/developer" Typo="Typo.caption">@Txt.S("карта возможностей →", "opportunity map →")</MudLink>
                    </div>
                    @foreach (var s in vm.Niches)
                    {
                        <div class="d-flex align-center py-1">
                            <MudLink Href="@($"/tags/{Uri.EscapeDataString(s.Key)}")" Style="min-width:0" Class="text-truncate">@s.Name</MudLink>
                            <MudSpacer />
                            <span class="itch-muted mr-3" style="font-size:.8rem">@(Ui.DemandUsesMean ? Txt.S("среднее", "mean") : Txt.S("медиана", "median")) @Fmt.N(Ui.DemandUsesMean ? s.Mean : s.Median, Ui.DemandUsesMean ? 1 : 0) · @Txt.S("игр", "games") @Fmt.Short(s.Denominator)</span>
                            <QuadrantChip @key="@($"{s.Key}:{Ui.Language}")" Value="s.Quadrant" />
                            <span class="itch-num ml-3" style="width:28px;text-align:right"><b>@Fmt.N(s.Opportunity, 0)</b></span>
                        </div>
                    }
                    @if (vm.Niches.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="itch-muted">@Txt.S("Нужно больше тегов с оценёнными играми.", "Need more tags with rated games.")</MudText>
                    }
                </MudPaper>
                <MudPaper Class="pa-4" Outlined="true">
                    <div class="d-flex align-center">
                        <div class="itch-section-title">@(vm.HotAvailable ? Txt.S("Горячее сейчас", "Hot right now") : Txt.S("Самые оценённые", "Most rated"))</div>
                        <MudSpacer />
                        <MudLink Href="/tops" Typo="Typo.caption">@Txt.S("все топы →", "all tops →")</MudLink>
                    </div>
                    @foreach (var g in vm.TopGames)
                    {
                        <div class="d-flex align-center py-1 gap-3">
                            <div style="flex:1;min-width:0"><GameCell Game="g" /></div>
                            <span class="itch-num">@Fmt.N(g.Ratings) @Txt.S("оц.", "rtg")</span>
                            @if (vm.HotAvailable && g.DeltaRatings is { } d)
                            {
                                <span class="itch-num" style="color:#4CC38A">@Fmt.Signed(d)</span>
                            }
                        </div>
                    }
                    @if (!vm.HotAvailable)
                    {
                        <MudText Typo="Typo.caption" Class="itch-muted">@Txt.S("«Горячее» появится после второго дня сбора: нужны два снимка, чтобы увидеть прирост.", "“Hot” appears after the second day of collection: two snapshots are needed to see the gain.")</MudText>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</DataGate>

@code {
    private sealed record Vm(
        SegmentStats All,
        int Known,
        int WithYear,
        double ZeroShare,
        List<Insight> Insights,
        List<ChartPoint> Distribution,
        List<ChartSeries> Years,
        List<ChartPoint> Genres,
        List<SegmentStats> Niches,
        List<GameRow> TopGames,
        bool HotAvailable);

    private Vm? _vm;

    protected override void Compute()
    {
        var games = A.Games(F);
        var all = A.All(F);
        var zeroShare = all.Denominator > 0 ? (double)all.Bin0 / all.Denominator : double.NaN;

        var known = games.Where(g => g.RatingsKnown).ToList();
        (string Label, int From, int To)[] bins =
            [("1–4", 1, 4), ("5–9", 5, 9), ("10–24", 10, 24), ("25–49", 25, 49), ("50–99", 50, 99), ("100–249", 100, 249), ("250–999", 250, 999), ("1000+", 1000, int.MaxValue)];
        var distribution = new List<ChartPoint> { new("0", all.Bin0) };
        distribution.AddRange(bins.Select(b => new ChartPoint(b.Label, known.Count(g => g.Ratings >= b.From && g.Ratings <= b.To))));

        var years = A.Years(F).Where(y => y.Year >= 2015 && (y.TotalItch is not null || y.Known >= 20)).ToList();
        var yearSeries = ChartData.Years(years);
        var withYear = games.Count(g => g.Year is not null);

        var useMean = Ui.DemandUsesMean;
        var genres = SegmentAnalyzer.WithDemand(A.Genres(F), A.Params, useMean).Where(s => s.Qualified > 0)
            .OrderByDescending(s => useMean ? s.AdjMean : s.AdjMedian)
            .Select(s => new ChartPoint(s.Name, useMean ? s.AdjMean : s.AdjMedian)).ToList();

        var niches = SegmentAnalyzer.WithDemand(A.Tags(F), A.Params, useMean)
            .Where(s => s.Opportunity is not null).OrderByDescending(s => s.Opportunity).Take(7).ToList();

        var hotAvailable = games.Any(g => g.Hot > 0);
        var top = hotAvailable
            ? games.Where(g => g.Hot > 0).OrderByDescending(g => g.Hot).Take(6).ToList()
            : games.OrderByDescending(g => g.Ratings).Take(6).ToList();

        _vm = new Vm(all, games.Count, withYear, zeroShare, A.Insights(F), distribution, yearSeries, genres, niches, top, hotAvailable);
    }
}
