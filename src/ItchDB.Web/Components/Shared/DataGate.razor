@* Shows loading and empty states before the page content. *@
@inject AnalyticsService Analytics

@if (!Analytics.IsLoaded)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="my-6">
        <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
        <MudText Class="itch-muted">@Txt.S("Загружаю данные в память…", "Loading data into memory…")</MudText>
    </MudStack>
}
else if (Snapshot.IsEmpty)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="my-4">
        @Txt.S("Данных пока нет. Откройте", "No data yet. Open") <MudLink Href="/data">@Txt.S("«Сбор данных»", "Data collection")</MudLink> @Txt.S("и запустите «Быстрый старт» — первые выводы появятся через полчаса.", "and start “Quick start” — the first conclusions appear in about half an hour.")
    </MudAlert>
}
else if (Error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="my-4">@Txt.S($"Не удалось посчитать показатели: {Error}", $"Could not compute the figures: {Error}")</MudAlert>
}
else
{
    @if (Busy)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Size="Size.Small" Class="mb-2" />
    }
    @ChildContent
}

@code {
    [Parameter, EditorRequired] public AnalyticsSnapshot Snapshot { get; set; } = AnalyticsSnapshot.Empty;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
