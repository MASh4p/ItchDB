@inject SettingsService Settings
@inject ISnackbar Snackbar

<MudGrid Spacing="3">
    <MudItem xs="12" md="6" lg="4">
        <MudText Typo="Typo.subtitle1" Class="mb-2">@Txt.S("Сеть", "Network")</MudText>
        <MudNumericField T="int" @bind-Value="_m.RequestIntervalMs" Label="@Txt.S("Интервал списков и тегов, мс", "List and tag interval, ms")" Min="0" Step="100" Variant="Variant.Outlined" Margin="Margin.Dense"
                         HelperText="@Txt.S("Пауза этой вкладки после списка или тега. Остальные вкладки в это время продолжают загрузку", "This tab pauses after a list or tag. The other tabs keep loading")" Class="mb-3" />
        <MudNumericField T="int" @bind-Value="_m.GamePageIntervalMs" Label="@Txt.S("Интервал страниц игр, мс", "Game page interval, ms")" Min="0" Step="100" Variant="Variant.Outlined" Margin="Margin.Dense"
                         HelperText="@Txt.S("Пауза этой вкладки после страницы игры. Остальные вкладки её не ждут", "This tab pauses after a game page. The other tabs do not wait for it")" Class="mb-3" />
        <MudNumericField T="int" @bind-Value="_m.ParallelRequests" Label="@Txt.S("Параллельных запросов", "Parallel requests")" Min="1" Max="8" Variant="Variant.Outlined" Margin="Margin.Dense"
                         HelperText="@Txt.S("Сколько вкладок грузят страницы одновременно. Запрос ждёт только свою вкладку", "How many tabs load pages at once. A request waits only for its own tab")" Class="mb-3" />
        <MudNumericField T="int" @bind-Value="_m.RequestJitterMs" Label="@Txt.S("Случайная добавка, мс", "Random extra delay, ms")" Min="0" Step="100" Variant="Variant.Outlined" Margin="Margin.Dense"
                         HelperText="@Txt.S("Добавляется к паузе вкладки, которая только что закончила загрузку", "Added to the pause of the tab that just finished loading")" Class="mb-3" />
        <MudTextField T="string" @bind-Value="_pauses" Label="@Txt.S("Паузы при Cloudflare, мин (через запятую)", "Cloudflare pauses, minutes (comma-separated)")" Variant="Variant.Outlined" Margin="Margin.Dense"
                      HelperText="@Txt.S("После последней паузы сбор останавливается", "After the last pause the crawl stops")" Class="mb-3" />
        <MudTextField T="string" @bind-Value="_m.UserAgent" Label="User-Agent" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2"
                      HelperText="@Txt.S("Должен совпадать с браузером, из которого взят cf_clearance", "Must match the browser the cf_clearance cookie came from")" />
    </MudItem>

    <MudItem xs="12" md="6" lg="4">
        <MudText Typo="Typo.subtitle1" Class="mb-2">@Txt.S("Расписание", "Schedule")</MudText>
        <MudSwitch T="bool" @bind-Value="_m.AutoDailyEnabled" Color="Color.Primary" Label="@Txt.S("Автоматическое ежедневное обновление", "Automatic daily update")" Class="mb-1" />
        <MudText Typo="Typo.caption" Class="itch-muted d-block mb-2">@Txt.S($"Если приложение закрыто, Планировщик заданий Windows запускает его в {WindowsDailyTask.LocalTime:HH:mm} и закрывает после сбора. Если открыто — обновление стартует само, когда приходит срок.", $"If the app is closed, Windows Task Scheduler starts it at {WindowsDailyTask.LocalTime:HH:mm} and closes it after the collection. If it is open, the update starts on its own when it is due.")</MudText>
        <MudNumericField T="int" @bind-Value="_m.DailyIntervalHours" Label="@Txt.S("Интервал, часов", "Interval, hours")" Min="1" Max="168" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" />

        <MudText Typo="Typo.subtitle1" Class="mb-2">@Txt.S("Аналитика", "Analytics")</MudText>
        <MudNumericField T="int" @bind-Value="_m.SuccessThreshold" Label="@Txt.S("«Успех» — оценок не меньше", "“Success” — at least this many ratings")" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense"
                         HelperText="@Txt.S("Порог для вероятности успеха P(≥X) и доли успешных", "Threshold for the success probability P(≥X) and the share of successes")" Class="mb-3" />
        <MudNumericField T="int" @bind-Value="_m.MinSegmentSample" Label="@Txt.S("Минимальная выборка сегмента", "Minimum segment sample")" Min="3" Variant="Variant.Outlined" Margin="Margin.Dense"
                         HelperText="@Txt.S("Сегменты с меньшим числом игр не участвуют в рейтингах", "Segments with fewer games are left out of the rankings")" Class="mb-3" />
        <MudNumericField T="double" @bind-Value="_m.ShrinkK" Label="@Txt.S("Сглаживание медианы k", "Median smoothing k")" Min="0" Step="5" Variant="Variant.Outlined" Margin="Margin.Dense"
                         HelperText="@Txt.S("adj = (n·медиана сегмента + k·общая медиана) / (n + k)", "adj = (n·segment median + k·overall median) / (n + k)")" Class="mb-3" />
        <MudNumericField T="int" @bind-Value="_m.BayesMinVotes" Label="@Txt.S("Взвешенный рейтинг: m", "Weighted rating: m")" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense"
                         HelperText="WR = v/(v+m)·R + m/(v+m)·C" />
    </MudItem>

    <MudItem xs="12" md="6" lg="4">
        <MudText Typo="Typo.subtitle1" Class="mb-2">@Txt.S("Opportunity score — веса", "Opportunity score — weights")</MudText>
        <MudNumericField T="double" @bind-Value="_m.WeightDemand" Label="@Txt.S("Спрос", "Demand")" Min="0" Max="1" Step="0.05" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
        <MudNumericField T="double" @bind-Value="_m.WeightSuccess" Label="@Txt.S("Шанс успеха", "Chance of success")" Min="0" Max="1" Step="0.05" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
        <MudNumericField T="double" @bind-Value="_m.WeightCompetition" Label="@Txt.S("Низкая конкуренция", "Low competition")" Min="0" Max="1" Step="0.05" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
        <MudNumericField T="double" @bind-Value="_m.WeightTrend" Label="@Txt.S("Тренд", "Trend")" Min="0" Max="1" Step="0.05" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" />

        <MudText Typo="Typo.subtitle1" Class="mb-2">@Txt.S("Горячее", "Hot")</MudText>
        <MudText Typo="Typo.caption" Class="itch-muted d-block mb-2">@Txt.S("Hot = (Δоценок за 7 дн + a·Δкомментариев + b·рост позиции) / (возраст в днях + 2)^g", "Hot = (Δratings over 7 days + a·Δcomments + b·rank gain) / (age in days + 2)^g")</MudText>
        <div class="d-flex gap-2">
            <MudNumericField T="double" @bind-Value="_m.HotA" Label="a" Min="0" Step="0.05" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudNumericField T="double" @bind-Value="_m.HotB" Label="b" Min="0" Step="0.05" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudNumericField T="double" @bind-Value="_m.HotG" Label="g" Min="0" Max="2" Step="0.05" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>
    </MudItem>

    <MudItem xs="12" md="6" lg="4">
        <MudText Typo="Typo.subtitle1" Class="mb-2">@Txt.S("Оценка аудитории", "Audience estimate")</MudText>
        <MudText Typo="Typo.caption" Class="itch-muted d-block mb-2">
            @Txt.S("Просмотры ≈ оценки / доля оценивающих. Без API-ключа используются отраслевые допущения; с ключом («Моя игра») — ваши реальные соотношения.",
                   "Views ≈ ratings / share of visitors who rate. Without an API key, industry assumptions are used; with a key (My game), your real ratios are used.")
        </MudText>
        <MudNumericField T="double" @bind-Value="_m.RaterShare" Label="@Txt.S("Доля оценивающих от просмотров", "Share of viewers who rate")" Min="0.0001" Max="1" Step="0.001" Format="0.####" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
        <div class="d-flex gap-2 mb-3">
            <MudNumericField T="double" @bind-Value="_m.RaterShareLow" Label="@Txt.S("Нижняя", "Lower")" Min="0.0001" Max="1" Step="0.001" Format="0.####" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudNumericField T="double" @bind-Value="_m.RaterShareHigh" Label="@Txt.S("Верхняя", "Upper")" Min="0.0001" Max="1" Step="0.001" Format="0.####" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>
        <MudNumericField T="double" @bind-Value="_m.WebPlayShare" Label="@Txt.S("Доля запусков в браузере от просмотров", "Share of views that become browser plays")" Min="0" Max="1" Step="0.01" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
        <MudNumericField T="double" @bind-Value="_m.DownloadShare" Label="@Txt.S("Доля скачиваний от просмотров", "Share of views that become downloads")" Min="0" Max="1" Step="0.01" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </MudItem>

    <MudItem xs="12" lg="8">
        <MudText Typo="Typo.subtitle1" Class="mb-2">@Txt.S("Объём сбора", "Crawl volume")</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="6" md="3"><MudNumericField T="int" @bind-Value="_m.QuickTopTags" Label="@Txt.S("Быстрый: тегов", "Quick: tags")" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="6" md="3"><MudNumericField T="int" @bind-Value="_m.QuickPagesPerList" Label="@Txt.S("Быстрый: стр. на тег", "Quick: pages per tag")" Min="1" Max="200" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="6" md="3"><MudNumericField T="int" @bind-Value="_m.QuickDetails" Label="@Txt.S("Быстрый: страниц игр", "Quick: game pages")" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="6" md="3"><MudNumericField T="int" @bind-Value="_m.JamEntriesPerRun" Label="@Txt.S("Джемов с участниками за запуск", "Jams with entries per run")" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="6" md="3"><MudNumericField T="int" @bind-Value="_m.DailyPopularTags" Label="@Txt.S("Ежедн.: тегов popular", "Daily: popular tags")" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="6" md="3"><MudNumericField T="int" @bind-Value="_m.DailyPopularPages" Label="@Txt.S("Ежедн.: стр. popular", "Daily: popular pages")" Min="1" Max="200" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="6" md="3"><MudNumericField T="int" @bind-Value="_m.DailyTopRatedPages" Label="@Txt.S("Ежедн.: стр. top-rated на тег", "Daily: top-rated pages per tag")" Min="1" Max="200" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="6" md="3"><MudNumericField T="int" @bind-Value="_m.DailyNewestMaxPages" Label="@Txt.S("Ежедн.: стр. новинок", "Daily: new-release pages")" Min="1" Max="200" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="6" md="3"><MudNumericField T="int" @bind-Value="_m.DailyDetails" Label="@Txt.S("Ежедн.: страниц игр", "Daily: game pages")" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="6" md="3"><MudNumericField T="int" @bind-Value="_m.DailyProfiles" Label="@Txt.S("Ежедн.: профилей", "Daily: profiles")" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="6" md="3"><MudNumericField T="int" @bind-Value="_m.DailyBacklogPages" Label="@Txt.S("Ежедн.: страниц глубокого сбора", "Daily: deep-crawl pages")" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="6" md="3"><MudNumericField T="int" @bind-Value="_m.DeepListPages" Label="@Txt.S("Глубокий: страниц списков", "Deep: list pages")" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="@Txt.S("0 — пока каталог не закончится", "0 — until the catalog ends")" /></MudItem>
            <MudItem xs="6" md="3"><MudNumericField T="int" @bind-Value="_m.DeepMinTagProjects" Label="@Txt.S("Глубокий: тег от N проектов", "Deep: tag from N projects")" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="6" md="3"><MudNumericField T="int" @bind-Value="_m.DeepRefreshDays" Label="@Txt.S("Перепроверять списки через, дней", "Recheck lists after, days")" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="6" md="3"><MudNumericField T="int" @bind-Value="_m.DeepDetails" Label="@Txt.S("Глубокий: страниц игр", "Deep: game pages")" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="6" md="3"><MudNumericField T="int" @bind-Value="_m.DeepProfiles" Label="@Txt.S("Глубокий: профилей", "Deep: profiles")" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
            <MudItem xs="6" md="3"><MudNumericField T="int" @bind-Value="_m.GamePagesPerRun" Label="@Txt.S("Карточки: страниц за запуск", "Pages: game pages per run")" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="@Txt.S("0 — все игры без карточки", "0 — every game without a page")" /></MudItem>
        </MudGrid>
    </MudItem>

    <MudItem xs="12" Class="d-flex gap-2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync">@Txt.S("Сохранить", "Save")</MudButton>
        <MudButton Variant="Variant.Text" OnClick="Revert">@Txt.S("Отменить изменения", "Discard changes")</MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Text" Color="Color.Warning" OnClick="ResetDefaults">@Txt.S("Значения по умолчанию", "Defaults")</MudButton>
    </MudItem>
</MudGrid>

@code {
    private AppSettingsModel _m = new();
    private string _pauses = "";

    protected override void OnInitialized() => Revert();

    private void Revert()
    {
        _m = Settings.Clone();
        _pauses = string.Join(", ", _m.CloudflarePauseMinutes);
    }

    private void ResetDefaults()
    {
        var keep = _m;
        _m = new AppSettingsModel
        {
            DefaultMinRatings = keep.DefaultMinRatings,
            DefaultShowNsfw = keep.DefaultShowNsfw,
            DefaultIncludeUnrated = keep.DefaultIncludeUnrated,
            CalibratedViewsPerRating = keep.CalibratedViewsPerRating,
            CalibratedDownloadsPerRating = keep.CalibratedDownloadsPerRating,
        };
        _pauses = string.Join(", ", _m.CloudflarePauseMinutes);
    }

    private async Task SaveAsync()
    {
        var pauses = _pauses.Split([',', ';', ' '], StringSplitOptions.RemoveEmptyEntries)
            .Select(p => int.TryParse(p, out var v) ? v : 0).Where(v => v > 0).ToArray();
        _m.CloudflarePauseMinutes = pauses.Length > 0 ? pauses : [10, 20, 40];
        var weights = _m.WeightDemand + _m.WeightSuccess + _m.WeightCompetition + _m.WeightTrend;
        if (weights <= 0)
        {
            Snackbar.Add(Txt.S("Сумма весов Opportunity должна быть больше нуля", "The Opportunity weights must add up to more than zero"), Severity.Error);
            return;
        }
        var current = Settings.Current;
        _m.DefaultMinRatings = current.DefaultMinRatings;
        _m.DefaultShowNsfw = current.DefaultShowNsfw;
        _m.DefaultIncludeUnrated = current.DefaultIncludeUnrated;
        _m.SmallGameThreshold = current.SmallGameThreshold;
        _m.DemandUsesMean = current.DemandUsesMean;
        await Settings.SaveAsync(_m);
        Revert();
        Snackbar.Add(Txt.S("Настройки сохранены", "Settings saved"), Severity.Success);
    }
}
