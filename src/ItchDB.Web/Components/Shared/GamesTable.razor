@* Games with configurable metric columns, paging and export. *@

<MudTable T="GameRow" Items="Games" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" RowsPerPage="@RowsPerPage"
          Class="itch-table" Elevation="0" SortLabel="@Txt.SortLabel">
    <ToolBarContent>
        @if (Title is not null)
        {
            <MudText Typo="Typo.h6">@Title</MudText>
        }
        @if (Subtitle is not null)
        {
            <MudText Typo="Typo.caption" Class="itch-muted ml-3">@Subtitle</MudText>
        }
        <MudSpacer />
        @ToolBar
        <ExportMenu T="GameRow" Name="@(ExportName ?? "games")" Rows="@(() => Games)" Columns="ExportColumns" />
    </ToolBarContent>
    <HeaderContent>
        @if (ShowRank)
        {
            <MudTh Style="width:44px">#</MudTh>
        }
        <MudTh>@Txt.S("Игра", "Game")</MudTh>
        <MudTh Style="text-align:right"><MudTableSortLabel T="GameRow" SortBy="g => g.Ratings">@Txt.S("Оценок", "Ratings")</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:right"><MudTableSortLabel T="GameRow" SortBy="g => g.RatingAvg ?? 0">★</MudTableSortLabel></MudTh>
        @if (ShowWr)
        {
            <MudTh Style="text-align:right">
                <MudTableSortLabel T="GameRow" SortBy="g => g.WeightedRating">WR</MudTableSortLabel>
                <FormulaTip Title="@_wr.Title" Formula="@_wr.Formula" Text="@_wr.Text" />
            </MudTh>
        }
        @if (ShowHot)
        {
            <MudTh Style="text-align:right">
                <MudTableSortLabel T="GameRow" SortBy="g => g.Hot">Hot</MudTableSortLabel>
                <FormulaTip Title="@Formulas.Hot.Title" Formula="@Formulas.Hot.Formula" Text="@Formulas.Hot.Text" />
            </MudTh>
        }
        @if (ShowDelta)
        {
            <MudTh Style="text-align:right"><MudTableSortLabel T="GameRow" SortBy="g => g.DeltaRatings ?? int.MinValue">@Txt.S("Δ оценок", "Δ ratings")</MudTableSortLabel></MudTh>
        }
        @if (!Compact)
        {
            <MudTh Style="text-align:right"><MudTableSortLabel T="GameRow" SortBy="g => g.Comments ?? -1">@Txt.S("Комм.", "Cmts")</MudTableSortLabel></MudTh>
            <MudTh>@Txt.S("Жанр", "Genre")</MudTh>
        <MudTh><MudTableSortLabel T="GameRow" SortBy="g => g.PublishedAt ?? new DateTime(g.Year ?? 1, 7, 1)">@Txt.S("Выход", "Released")</MudTableSortLabel></MudTh>
        <MudTh>@Txt.S("Платформы", "Platforms")</MudTh>
        <MudTh>@Txt.S("Цена", "Price")</MudTh>
        }
        @if (ShowFeatured)
        {
            <MudTh><MudTableSortLabel T="GameRow" SortBy="g => g.FeaturedAt ?? DateTime.MinValue">Featured</MudTableSortLabel></MudTh>
        }
    </HeaderContent>
    <RowTemplate>
        @if (ShowRank)
        {
            <MudTd Class="itch-muted itch-num">@(Rank(context))</MudTd>
        }
        <MudTd DataLabel="@Txt.S("Игра", "Game")" Style="max-width:360px"><GameCell Game="context" /></MudTd>
        <MudTd DataLabel="@Txt.S("Оценок", "Ratings")" Class="itch-num" Style="text-align:right">@(context.RatingsKnown ? Fmt.N(context.Ratings) : "?")</MudTd>
        <MudTd DataLabel="★" Class="itch-num" Style="text-align:right">@Fmt.Stars(context.RatingAvg)</MudTd>
        @if (ShowWr)
        {
            <MudTd DataLabel="WR" Class="itch-num" Style="text-align:right">@(context.WeightedRating > 0 ? Fmt.N(context.WeightedRating, 2) : "—")</MudTd>
        }
        @if (ShowHot)
        {
            <MudTd DataLabel="Hot" Class="itch-num" Style="text-align:right">@(context.Hot > 0 ? Fmt.N(context.Hot, 2) : "—")</MudTd>
        }
        @if (ShowDelta)
        {
            <MudTd DataLabel="@Txt.S("Δ оценок", "Δ ratings")" Class="itch-num" Style="text-align:right">
                @(context.DeltaRatings is { } d ? DeltaText(d, context.DeltaDays) : "—")
            </MudTd>
        }
        @if (!Compact)
        {
            <MudTd DataLabel="@Txt.S("Комм.", "Cmts")" Class="itch-num" Style="text-align:right">@Fmt.N(context.Comments)</MudTd>
            <MudTd DataLabel="@Txt.S("Жанр", "Genre")">@GenreName(context.Genre)</MudTd>
            <MudTd DataLabel="@Txt.S("Выход", "Released")" Class="itch-num">@(context.PublishedAt is { } p ? Fmt.Date(p) : context.Year?.ToString() ?? "—")</MudTd>
            <MudTd DataLabel="@Txt.S("Платформы", "Platforms")" Style="font-size:.78rem">@Fmt.Platforms(context.Platforms)</MudTd>
            <MudTd DataLabel="@Txt.S("Цена", "Price")" Style="font-size:.8rem">@Fmt.Price(context)</MudTd>
        }
        @if (ShowFeatured)
        {
            <MudTd DataLabel="Featured" Class="itch-num">@Fmt.Date(context.FeaturedAt)</MudTd>
        }
    </RowTemplate>
    <PagerContent>
        <MudTablePager RowsPerPageString="@Txt.RowsLabel" InfoFormat="@Txt.PagerInfo" PageSizeOptions="new[] { 10, 25, 50, 100, 250 }" />
    </PagerContent>
    <NoRecordsContent>
        <MudText Class="itch-muted">@(Empty ?? Txt.S("Игр не найдено.", "No games found."))</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<GameRow> Games { get; set; } = [];
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? ExportName { get; set; }
    [Parameter] public bool ShowRank { get; set; } = true;
    [Parameter] public bool ShowWr { get; set; } = true;
    [Parameter] public bool ShowHot { get; set; }
    [Parameter] public bool ShowDelta { get; set; }
    [Parameter] public bool ShowFeatured { get; set; }
    [Parameter] public int RowsPerPage { get; set; } = 25;
    [Parameter] public int BayesMinVotes { get; set; } = 20;
    [Parameter] public string? Empty { get; set; }
    [Parameter] public RenderFragment? ToolBar { get; set; }
    [Parameter] public bool Compact { get; set; }

    private Formulas.Tip _wr = Formulas.WeightedRating(20);
    private Dictionary<long, int> _ranks = [];

    protected override void OnParametersSet()
    {
        _wr = Formulas.WeightedRating(BayesMinVotes);
        _ranks = new Dictionary<long, int>(Games.Count);
        for (var i = 0; i < Games.Count; i++) _ranks.TryAdd(Games[i].Id, i + 1);
    }

    private string Rank(GameRow g) => _ranks.TryGetValue(g.Id, out var r) ? r.ToString() : "";

    public static string GenreName(string? slug) => slug is null ? "—"
        : ItchCatalog.GenreFromSlug(slug) is { } g ? CatalogNames.Genre(g, TextLang.Current) : ItchCatalog.NameFromSlug(slug);

    private string DeltaText(int delta, int days) => Txt.Lang == UiLanguage.En
        ? $"{Fmt.Signed(delta)} in {days}d"
        : $"{Fmt.Signed(delta)} за {Fmt.Count(days, "день", "дня", "дней")}";

    private IReadOnlyList<ExportColumn<GameRow>> ExportColumns =>
    [
        new("ID", g => g.Id),
        new(Txt.S("Название", "Title"), g => g.Title),
        new(Txt.S("Автор", "Author"), g => g.AuthorName),
        new(Txt.S("Ссылка", "Link"), g => g.Url),
        new(Txt.S("Оценок", "Ratings"), g => g.RatingsKnown ? g.Ratings : null),
        new(Txt.S("Средняя ★", "Average ★"), g => g.RatingAvg),
        new("WR", g => g.WeightedRating > 0 ? g.WeightedRating : null),
        new(Txt.S("Комментариев", "Comments"), g => g.Comments),
        new(Txt.S("Δ оценок", "Δ ratings"), g => g.DeltaRatings),
        new(Txt.S("Дней в окне Δ", "Days in the Δ window"), g => g.DeltaDays > 0 ? g.DeltaDays : null),
        new("Hot", g => g.Hot > 0 ? g.Hot : null),
        new(Txt.S("Жанр", "Genre"), g => GenreName(g.Genre)),
        new(Txt.S("Дата выхода", "Release date"), g => g.PublishedAt),
        new(Txt.S("Год", "Year"), g => g.Year),
        new(Txt.S("Платформы", "Platforms"), g => Fmt.Platforms(g.Platforms)),
        new(Txt.S("Цена", "Price"), g => Fmt.Price(g)),
        new(Txt.S("Статус", "Status"), g => Fmt.Status(g.Status)),
        new(Txt.S("Скриншотов", "Screenshots"), g => g.HasDetails ? g.Screenshots : null),
        new("18+", g => g.IsNsfw),
        new("Featured", g => g.FeaturedAt),
        new(Txt.S("Джем", "Jam"), g => g.IsJamEntry),
        new(Txt.S("Место в popular", "Place in popular"), g => g.PopularRank),
    ];
}
