@* What goes along with more ratings: uplift per feature and the OLS model controlling for age. *@

<MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-3">
    <b>@Txt.S("Корреляция ≠ причинность.", "Correlation is not causation.")</b> @Txt.S("Здесь показано, что сопутствует большему числу оценок, а не что его вызывает. Например, у популярных игр больше скриншотов отчасти потому, что их авторы вообще больше вкладываются в игру и её страницу. Используйте как подсказку, где искать, а не как рецепт.",
           "This shows what goes along with more ratings, not what causes them. Popular games have more screenshots partly because their authors invest more in the game and its page. Use it as a hint for where to look, not as a recipe.")
</MudAlert>

@if (Report.Sample < 2 * Drivers.MinGroupSize)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        @Txt.S($"Для анализа нужны игры с прочитанными страницами (полные теги, скриншоты, статус). Сейчас их {Report.Sample} — запустите глубокий сбор.",
               $"The analysis needs games whose pages have been read (full tags, screenshots, status). There are {Report.Sample} now — run a deep crawl.")
    </MudAlert>
}
else
{
    <MudGrid Spacing="3" Class="mb-2">
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-4 itch-card" Outlined="true">
                <Kpi Label="@Txt.S("Выборка", "Sample")" Value="@Fmt.N(Report.Sample)" Large="true" Hint="@Txt.S("игр с прочитанной страницей", "games with a page read")"
                     Tip="@Txt.S("Только у этих игр известны все теги, скриншоты, статус и отметка об ИИ.", "Only these games have every tag, screenshot count, status, and AI disclosure.")" />
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-4 itch-card" Outlined="true">
                <Kpi Label="@Txt.S("Качество модели (R²)", "Model fit (R²)")" Value="@(Report.RSquared is { } r2 ? r2.ToString("0.00", Fmt.Ru) : "—")" Large="true"
                     Hint="@(Report.RSquared is null ? Txt.S($"нужно ≥ 200 игр с прочитанными страницами, сейчас {Fmt.N(Report.Sample)}", $"needs ≥ 200 games with pages read, currently {Fmt.N(Report.Sample)}") : Txt.S($"{Report.ModelFeatures} факторов + возраст и скриншоты", $"{Report.ModelFeatures} factors + age and screenshots"))"
                     Formula="@Txt.S("log(1 + оценки) = β₀ + β₁·log(1 + возраст) + β₂·log(1 + скриншоты) + Σ βᵢ·фактор", "log(1 + ratings) = β₀ + β₁·log(1 + age) + β₂·log(1 + screenshots) + Σ βᵢ·factor")"
                     Tip="@Txt.S("Доля разброса log(оценок), которую объясняют факторы. Остальное — сама игра: идея, качество, удача, продвижение.", "Share of the spread in log(ratings) that the factors explain. The rest is the game itself: idea, quality, luck, promotion.")" />
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-4 itch-card" Outlined="true">
                <Kpi Label="@Txt.S("Возраст ×2", "Age ×2")" Value="@Fmt.Times(Report.AgeDoublingMultiplier)" Large="true" Hint="@Txt.S("к числу оценок", "to the rating count")"
                     Tip="@Txt.S("Во сколько раз больше оценок у игры, которая вдвое старше, при прочих равных.", "How many times more ratings a game has when it is twice as old, all else equal.")" />
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-4 itch-card" Outlined="true">
                <Kpi Label="@Txt.S("Скриншотов ×2", "Screenshots ×2")" Value="@Fmt.Times(Report.ScreenshotsDoublingMultiplier)" Large="true" Hint="@Txt.S("к числу оценок", "to the rating count")"
                     Tip="@Txt.S("Во сколько раз больше оценок у игры с вдвое большим числом скриншотов, при прочих равных.", "How many times more ratings a game has with twice as many screenshots, all else equal.")" />
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudTable T="DriverResult" Items="Report.Results" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" RowsPerPage="50" SortLabel="@Txt.SortLabel"
              Class="itch-table mb-3" Elevation="0" Filter="Matches">
        <ToolBarContent>
            <MudText Typo="Typo.h6">@Txt.S("Факторы", "Factors")</MudText>
            <MudSpacer />
            <MudSwitch T="bool" @bind-Value="_onlySignificant" Color="Color.Primary" Label="@Txt.S("Только значимые", "Significant only")" Class="mr-2" />
            <ExportMenu T="DriverResult" Name="success-drivers" Rows="@(() => Report.Results.Where(Matches))" Columns="ExportColumns" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel T="DriverResult" SortBy="r => r.Name">@Txt.S("Фактор", "Factor")</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="DriverResult" SortBy="r => r.Group">@Txt.S("Группа", "Group")</MudTableSortLabel></MudTh>
            <MudTh Style="text-align:right"><MudTableSortLabel T="DriverResult" SortBy="r => r.With">@Txt.S("Игр с / без", "Games with / without")</MudTableSortLabel></MudTh>
            <MudTh Style="text-align:right">@Txt.S("Медиана с / без", "Median with / without")</MudTh>
            <MudTh Style="text-align:right">@Txt.S($"Шанс ≥ {SuccessThreshold} с / без", $"Chance ≥ {SuccessThreshold} with / without")</MudTh>
            <MudTh Style="text-align:right">
                <MudTableSortLabel T="DriverResult" SortBy="r => r.Uplift.HasValue ? r.Uplift.Value.Ratio : 0">Uplift</MudTableSortLabel>
                <FormulaTip Title="@Formulas.Uplift.Title" Formula="@Formulas.Uplift.Formula" Text="@Formulas.Uplift.Text" />
            </MudTh>
            <MudTh Style="text-align:right">
                <MudTableSortLabel T="DriverResult" SortBy="r => r.Multiplier ?? 0" InitialDirection="SortDirection.Descending">@Txt.S("Множитель", "Multiplier")</MudTableSortLabel>
                <FormulaTip Title="@Formulas.Multiplier.Title" Formula="@Formulas.Multiplier.Formula" Text="@Formulas.Multiplier.Text" />
            </MudTh>
            <MudTh Style="text-align:right">p</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@Txt.S("Фактор", "Factor")">@context.Name</MudTd>
            <MudTd DataLabel="@Txt.S("Группа", "Group")" Class="itch-muted">@context.Group</MudTd>
            <MudTd DataLabel="@Txt.S("Игр", "Games")" Class="itch-num" Style="text-align:right">@Fmt.N(context.With) / @Fmt.N(context.Without)</MudTd>
            <MudTd DataLabel="@Txt.S("Медиана", "Median")" Class="itch-num" Style="text-align:right">@Fmt.N(context.MedianWith, 0) / @Fmt.N(context.MedianWithout, 0)</MudTd>
            <MudTd DataLabel="@Txt.S("Шанс", "Chance")" Class="itch-num" Style="text-align:right">@Fmt.Pct(context.SuccessWith, 1) / @Fmt.Pct(context.SuccessWithout, 1)</MudTd>
            <MudTd DataLabel="Uplift" Class="itch-num" Style="text-align:right">
                @if (context.Uplift is { } u)
                {
                    <MudTooltip Text="@($"95%: {Fmt.Times(u.Low)} – {Fmt.Times(u.High)}")">
                        <span style="color:@(u.Low > 1 ? "#4CC38A" : u.High < 1 ? "#FF8A8A" : "inherit")">@Fmt.Times(u.Ratio)</span>
                    </MudTooltip>
                }
                else
                {
                    <span class="itch-muted">—</span>
                }
            </MudTd>
            <MudTd DataLabel="@Txt.S("Множитель", "Multiplier")" Class="itch-num" Style="text-align:right">
                @if (context.Multiplier is { } m)
                {
                    <MudTooltip Text="@($"95%: {Fmt.Times(context.MultiplierLow)} – {Fmt.Times(context.MultiplierHigh)}")">
                        <b style="color:@(context.Significant ? (m > 1 ? "#4CC38A" : "#FF8A8A") : "inherit")">@Fmt.Times(m)</b>
                    </MudTooltip>
                }
                else
                {
                    <span class="itch-muted">—</span>
                }
            </MudTd>
            <MudTd DataLabel="p" Class="itch-num itch-muted" Style="text-align:right">@(context.PValue is { } p ? (p < 0.001 ? Txt.S("<0,001", "<0.001") : p.ToString("0.000", Fmt.Ru)) : "—")</MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager RowsPerPageString="@Txt.RowsLabel" InfoFormat="@Txt.PagerInfo" PageSizeOptions="new[] { 25, 50, 100 }" />
        </PagerContent>
    </MudTable>

    @if (Report.Correlations.Count > 0)
    {
        <MudPaper Class="pa-4" Outlined="true">
            <div class="itch-section-title">
                @Txt.S("Связь с числом оценок (ранговая корреляция Спирмена)", "Link with the rating count (Spearman rank correlation)")
                <FormulaTip Title="@Txt.S("ρ Спирмена", "Spearman ρ")" Formula="@Txt.S("ρ = корреляция рангов, от −1 до 1", "ρ = rank correlation, from −1 to 1")" Text="@Txt.S("0 — связи нет, 0,3 — заметная, 0,5 и выше — сильная. Не учитывает другие факторы.", "0 means no link, 0.3 is noticeable, 0.5 and above is strong. It does not account for other factors.")" />
            </div>
            @foreach (var c in Report.Correlations)
            {
                <div class="d-flex align-center gap-3 py-1">
                    <span style="width:220px">@c.Name</span>
                    <div class="itch-bar-bg" style="width:160px">
                        <div class="itch-bar-fill" style="@($"width:{Math.Abs(c.Rho) * 100:0}%;background:{(c.Rho >= 0 ? "#4CC38A" : "#FF8A8A")}")"></div>
                    </div>
                    <b class="itch-num" style="width:56px">@c.Rho.ToString("+0.00;−0.00;0", Fmt.Ru)</b>
                    <span class="itch-muted" style="font-size:.82rem">@c.Note · n = @Fmt.N(c.N)</span>
                </div>
            }
        </MudPaper>
    }
}

@code {
    [Parameter, EditorRequired] public DriversReport Report { get; set; } = DriversReport.Empty;
    [Parameter] public int MinRatings { get; set; } = 4;
    [Parameter] public int SuccessThreshold { get; set; } = 10;

    private bool _onlySignificant;

    private bool Matches(DriverResult r) => !_onlySignificant || r.Significant || r.Uplift is { } u && (u.Low > 1 || u.High < 1);

    private IReadOnlyList<ExportColumn<DriverResult>> ExportColumns =>
    [
        new(Txt.S("Фактор", "Factor"), r => r.Name),
        new(Txt.S("Группа", "Group"), r => r.Group),
        new(Txt.S("Игр с фактором", "Games with the factor"), r => r.With),
        new(Txt.S("Игр без", "Games without"), r => r.Without),
        new(Txt.S("Медиана с", "Median with"), r => r.MedianWith),
        new(Txt.S("Медиана без", "Median without"), r => r.MedianWithout),
        new(Txt.S($"Шанс ≥ {SuccessThreshold} с", $"Chance ≥ {SuccessThreshold} with"), r => r.SuccessWith),
        new(Txt.S($"Шанс ≥ {SuccessThreshold} без", $"Chance ≥ {SuccessThreshold} without"), r => r.SuccessWithout),
        new("Uplift", r => r.Uplift?.Ratio),
        new(Txt.S("Uplift: нижняя граница", "Uplift: lower bound"), r => r.Uplift?.Low),
        new(Txt.S("Uplift: верхняя граница", "Uplift: upper bound"), r => r.Uplift?.High),
        new(Txt.S("Множитель", "Multiplier"), r => r.Multiplier),
        new(Txt.S("Множитель: нижняя граница", "Multiplier: lower bound"), r => r.MultiplierLow),
        new(Txt.S("Множитель: верхняя граница", "Multiplier: upper bound"), r => r.MultiplierHigh),
        new("p", r => r.PValue),
        new(Txt.S("Значим", "Significant"), r => r.Significant),
    ];
}
