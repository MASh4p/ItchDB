@* Pairs of tags that work better (or worse) together than each tag alone. *@

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
    @Txt.S("Lift — медиана оценок игр с обоими тегами, делённая на лучшую из медиан по отдельности. Больше ×1 — сочетание работает лучше, чем каждый тег сам по себе; меньше — теги «спорят» за одну аудиторию.",
           "Lift is the median ratings of games with both tags, divided by the better of the two tags alone. Above ×1, the pair works better than either tag by itself; below, the tags compete for the same audience.")
</MudAlert>

<MudTable T="TagComboResult" Items="_rows" Filter="Matches" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" RowsPerPage="50"
          SortLabel="@Txt.SortLabel" Class="itch-table" Elevation="0">
    <ToolBarContent>
        <MudText Typo="Typo.h6">@Txt.S("Сочетания тегов", "Tag combinations")</MudText>
        <MudText Typo="Typo.caption" Class="itch-muted ml-3">@Txt.S($"{Fmt.N(_rows.Count)} пар", $"{Fmt.N(_rows.Count)} pairs")</MudText>
        <MudSpacer />
        <MudTextField T="string" @bind-Value="_search" Placeholder="@Txt.S("Тег", "Tag")" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Small" Variant="Variant.Outlined" Margin="Margin.Dense" Class="itch-search mr-2" />
        <MudSelect T="int" @bind-Value="_minGames" @bind-Value:after="Rebuild" Label="@Txt.S("Игр в паре от", "Games in the pair from")" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="max-width:180px" Class="mr-2">
            @foreach (var n in new[] { 15, 30, 50, 100, 250 })
            {
                <MudSelectItem T="int" Value="n">@n</MudSelectItem>
            }
        </MudSelect>
        <ExportMenu T="TagComboResult" Name="tag-combos" Rows="@(() => _rows.Where(Matches))" Columns="ExportColumns" />
    </ToolBarContent>
    <HeaderContent>
        <MudTh>@Txt.S("Сочетание", "Combination")</MudTh>
        <MudTh Style="text-align:right"><MudTableSortLabel T="TagComboResult" SortBy="c => c.Games">@Txt.S("Игр", "Games")</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:right"><MudTableSortLabel T="TagComboResult" SortBy="c => c.Qualified">@Txt.S($"С оценками ≥ {MinRatings}", $"With ≥ {MinRatings} ratings")</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:right"><MudTableSortLabel T="TagComboResult" SortBy="c => c.Median">@Txt.S("Медиана пары", "Pair median")</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:right">@Txt.S("Медианы по отдельности", "Medians alone")</MudTh>
        <MudTh Style="text-align:right">
            <MudTableSortLabel T="TagComboResult" SortBy="c => c.Lift" InitialDirection="SortDirection.Descending">Lift</MudTableSortLabel>
            <FormulaTip Title="@Formulas.Lift.Title" Formula="@Formulas.Lift.Formula" Text="@Formulas.Lift.Text" />
        </MudTh>
        <MudTh Style="text-align:right"><MudTableSortLabel T="TagComboResult" SortBy="c => c.SuccessShare">@Txt.S($"Шанс ≥ {SuccessThreshold}", $"Chance ≥ {SuccessThreshold}")</MudTableSortLabel></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@Txt.S("Сочетание", "Combination")">
            <MudLink Href="@($"/tags/{Uri.EscapeDataString(context.A.Slug)}")">@Segments.DisplayName(context.A)</MudLink>
            <span class="itch-muted"> + </span>
            <MudLink Href="@($"/tags/{Uri.EscapeDataString(context.B.Slug)}")">@Segments.DisplayName(context.B)</MudLink>
            <MudIconButton Icon="@Icons.Material.Filled.Lightbulb" Size="Size.Small" title="@Txt.S("Проверить идею с этими тегами", "Check an idea with these tags")"
                           Href="@($"/developer?tab=concept&tags={Uri.EscapeDataString(context.A.Slug)},{Uri.EscapeDataString(context.B.Slug)}")" />
        </MudTd>
        <MudTd DataLabel="@Txt.S("Игр", "Games")" Class="itch-num" Style="text-align:right">@Fmt.N(context.Games)</MudTd>
        <MudTd DataLabel="@Txt.S("С оценками", "With ratings")" Class="itch-num" Style="text-align:right">@Fmt.N(context.Qualified)</MudTd>
        <MudTd DataLabel="@Txt.S("Медиана пары", "Pair median")" Class="itch-num" Style="text-align:right"><b>@Fmt.N(context.Median, 0)</b></MudTd>
        <MudTd DataLabel="@Txt.S("По отдельности", "Alone")" Class="itch-num itch-muted" Style="text-align:right">@Fmt.N(context.MedianA, 0) / @Fmt.N(context.MedianB, 0)</MudTd>
        <MudTd DataLabel="Lift" Class="itch-num" Style="@($"text-align:right;color:{LiftColor(context.Lift)}")">@Fmt.Times(context.Lift)</MudTd>
        <MudTd DataLabel="@Txt.S("Шанс", "Chance")" Class="itch-num" Style="text-align:right">@Fmt.Pct(context.SuccessShare, 1)</MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager RowsPerPageString="@Txt.RowsLabel" InfoFormat="@Txt.PagerInfo" PageSizeOptions="new[] { 25, 50, 100, 500 }" />
    </PagerContent>
    <NoRecordsContent>
        <MudText Class="itch-muted">@Txt.S("Нет пар с достаточным числом игр. Уменьшите порог или соберите больше данных.", "No pairs have enough games. Lower the threshold or collect more data.")</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TagComboResult> Combos { get; set; } = [];
    [Parameter] public int MinRatings { get; set; } = 4;
    [Parameter] public int SuccessThreshold { get; set; } = 10;

    private List<TagComboResult> _rows = [];
    private string? _search;
    private int _minGames = 30;
    private IReadOnlyList<TagComboResult>? _source;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_source, Combos)) return;
        _source = Combos;
        Rebuild();
    }

    private void Rebuild() => _rows = Combos.Where(c => !double.IsNaN(c.Lift) && c.Games >= _minGames).OrderByDescending(c => c.Lift).ToList();

    private bool Matches(TagComboResult c) =>
        string.IsNullOrWhiteSpace(_search)
        || c.A.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || c.B.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || Segments.DisplayName(c.A).Contains(_search, StringComparison.OrdinalIgnoreCase)
        || Segments.DisplayName(c.B).Contains(_search, StringComparison.OrdinalIgnoreCase);

    private static string LiftColor(double lift) => lift switch
    {
        >= 1.2 => "#4CC38A",
        < 0.9 => "#FF8A8A",
        _ => "inherit",
    };

    private IReadOnlyList<ExportColumn<TagComboResult>> ExportColumns =>
    [
        new(Txt.S("Тег A", "Tag A"), c => Segments.DisplayName(c.A)),
        new(Txt.S("Тег B", "Tag B"), c => Segments.DisplayName(c.B)),
        new(Txt.S("Игр", "Games"), c => c.Games),
        new(Txt.S($"С оценками ≥ {MinRatings}", $"With ≥ {MinRatings} ratings"), c => c.Qualified),
        new(Txt.S("Медиана пары", "Pair median"), c => c.Median),
        new(Txt.S("Медиана A", "Median A"), c => c.MedianA),
        new(Txt.S("Медиана B", "Median B"), c => c.MedianB),
        new("Lift", c => c.Lift),
        new(Txt.S($"Успешных (≥ {SuccessThreshold})", $"Successes (≥ {SuccessThreshold})"), c => c.Successes),
        new(Txt.S("Шанс", "Chance"), c => c.SuccessShare),
    ];
}
