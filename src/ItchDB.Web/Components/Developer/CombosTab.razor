@* Pairs of tags that work better (or worse) together than each tag alone. *@

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
    <b>Lift</b> — медиана оценок игр с обоими тегами, делённая на лучшую из медиан по отдельности.
    Больше ×1 — сочетание работает лучше, чем каждый тег сам по себе; меньше — теги «спорят» за одну аудиторию.
</MudAlert>

<MudTable T="TagComboResult" Items="_rows" Filter="Matches" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" RowsPerPage="50"
          SortLabel="Сортировка" Class="itch-table" Elevation="0">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Сочетания тегов</MudText>
        <MudText Typo="Typo.caption" Class="itch-muted ml-3">@Fmt.N(_rows.Count) пар</MudText>
        <MudSpacer />
        <MudTextField T="string" @bind-Value="_search" Placeholder="Тег" Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Small" Variant="Variant.Outlined" Margin="Margin.Dense" Class="itch-search mr-2" />
        <MudSelect T="int" @bind-Value="_minGames" @bind-Value:after="Rebuild" Label="Игр в паре от" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="max-width:150px" Class="mr-2">
            @foreach (var n in new[] { 15, 30, 50, 100, 250 })
            {
                <MudSelectItem T="int" Value="n">@n</MudSelectItem>
            }
        </MudSelect>
        <ExportMenu T="TagComboResult" Name="tag-combos" Rows="@(() => _rows.Where(Matches))" Columns="ExportColumns" />
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Сочетание</MudTh>
        <MudTh Style="text-align:right"><MudTableSortLabel T="TagComboResult" SortBy="c => c.Games">Игр</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:right"><MudTableSortLabel T="TagComboResult" SortBy="c => c.Qualified">С оценками ≥ @MinRatings</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:right"><MudTableSortLabel T="TagComboResult" SortBy="c => c.Median">Медиана пары</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:right">Медианы по отдельности</MudTh>
        <MudTh Style="text-align:right">
            <MudTableSortLabel T="TagComboResult" SortBy="c => c.Lift" InitialDirection="SortDirection.Descending">Lift</MudTableSortLabel>
            <FormulaTip Title="@Formulas.Lift.Title" Formula="@Formulas.Lift.Formula" Text="@Formulas.Lift.Text" />
        </MudTh>
        <MudTh Style="text-align:right"><MudTableSortLabel T="TagComboResult" SortBy="c => c.SuccessShare">Шанс ≥ @SuccessThreshold</MudTableSortLabel></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Сочетание">
            <MudLink Href="@($"/tags/{Uri.EscapeDataString(context.A.Slug)}")">@Segments.DisplayName(context.A)</MudLink>
            <span class="itch-muted"> + </span>
            <MudLink Href="@($"/tags/{Uri.EscapeDataString(context.B.Slug)}")">@Segments.DisplayName(context.B)</MudLink>
            <MudIconButton Icon="@Icons.Material.Filled.Lightbulb" Size="Size.Small" title="Проверить идею с этими тегами"
                           Href="@($"/developer?tab=concept&tags={Uri.EscapeDataString(context.A.Slug)},{Uri.EscapeDataString(context.B.Slug)}")" />
        </MudTd>
        <MudTd DataLabel="Игр" Class="itch-num" Style="text-align:right">@Fmt.N(context.Games)</MudTd>
        <MudTd DataLabel="С оценками" Class="itch-num" Style="text-align:right">@Fmt.N(context.Qualified)</MudTd>
        <MudTd DataLabel="Медиана пары" Class="itch-num" Style="text-align:right"><b>@Fmt.N(context.Median, 0)</b></MudTd>
        <MudTd DataLabel="По отдельности" Class="itch-num itch-muted" Style="text-align:right">@Fmt.N(context.MedianA, 0) / @Fmt.N(context.MedianB, 0)</MudTd>
        <MudTd DataLabel="Lift" Class="itch-num" Style="@($"text-align:right;color:{LiftColor(context.Lift)}")">@Fmt.Times(context.Lift)</MudTd>
        <MudTd DataLabel="Шанс" Class="itch-num" Style="text-align:right">@Fmt.Pct(context.SuccessShare, 1)</MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager RowsPerPageString="Строк:" InfoFormat="{first_item}–{last_item} из {all_items}" PageSizeOptions="new[] { 25, 50, 100, 500 }" />
    </PagerContent>
    <NoRecordsContent>
        <MudText Class="itch-muted">Нет пар с достаточным числом игр. Уменьшите порог или соберите больше данных.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TagComboResult> Combos { get; set; } = [];
    [Parameter] public int MinRatings { get; set; } = 4;
    [Parameter] public int SuccessThreshold { get; set; } = 10;

    private List<TagComboResult> _rows = [];
    private string? _search;
    private int _minGames = 30;
    private IReadOnlyList<TagComboResult>? _source;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_source, Combos)) return;
        _source = Combos;
        Rebuild();
    }

    private void Rebuild() => _rows = Combos.Where(c => !double.IsNaN(c.Lift) && c.Games >= _minGames).OrderByDescending(c => c.Lift).ToList();

    private bool Matches(TagComboResult c) =>
        string.IsNullOrWhiteSpace(_search)
        || c.A.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || c.B.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || Segments.DisplayName(c.A).Contains(_search, StringComparison.OrdinalIgnoreCase)
        || Segments.DisplayName(c.B).Contains(_search, StringComparison.OrdinalIgnoreCase);

    private static string LiftColor(double lift) => lift switch
    {
        >= 1.2 => "#4CC38A",
        < 0.9 => "#FF8A8A",
        _ => "inherit",
    };

    private IReadOnlyList<ExportColumn<TagComboResult>> ExportColumns =>
    [
        new("Тег A", c => Segments.DisplayName(c.A)),
        new("Тег B", c => Segments.DisplayName(c.B)),
        new("Игр", c => c.Games),
        new($"С оценками ≥ {MinRatings}", c => c.Qualified),
        new("Медиана пары", c => c.Median),
        new("Медиана A", c => c.MedianA),
        new("Медиана B", c => c.MedianB),
        new("Lift", c => c.Lift),
        new($"Успешных (≥ {SuccessThreshold})", c => c.Successes),
        new("Шанс", c => c.SuccessShare),
    ];
}
