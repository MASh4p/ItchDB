@inherits LayoutComponentBase
@implements IDisposable
@inject UiState Ui

<MudThemeProvider Theme="ItchTheme.Theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="itch-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" aria-label="Меню" />
        <MudText Typo="Typo.h6" Class="ml-2 itch-logo">Itch<span>DB</span></MudText>
        <MudText Typo="Typo.caption" Class="ml-3 mud-text-secondary d-none d-md-flex">локальная аналитика itch.io</MudText>
        <MudSpacer />

        <CrawlStatusBar />

        <MudTooltip Text="Игры 18+ — отдельная аудитория, которая искажает топы и медианы. По умолчанию скрыты.">
            <MudSwitch T="bool" Value="Ui.ShowNsfw" ValueChanged="@(v => Ui.ShowNsfw = v)" Color="Color.Primary"
                       Label="18+" Class="mr-4" />
        </MudTooltip>

        <MudTooltip Text="Медианы и доли считаются только по играм, у которых оценок не меньше порога. У 81% игр оценок нет, поэтому медиана по всем играм всегда 0.">
            <MudSelect T="int" Value="Ui.MinRatings" ValueChanged="@(v => Ui.MinRatings = v)" Dense="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Label="Мин. оценок" Class="itch-min-select mr-3">
                @foreach (var v in UiState.MinRatingOptions)
                {
                    <MudSelectItem T="int" Value="v">@($"≥ {v}")</MudSelectItem>
                }
            </MudSelect>
        </MudTooltip>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Variant="DrawerVariant.Responsive">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="py-4 px-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Произошла ошибка.
    <a href="." class="reload">Перезагрузить</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;

    protected override void OnInitialized() => Ui.Changed += OnUiChanged;

    private void OnUiChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Ui.Changed -= OnUiChanged;
}
