@inherits LayoutComponentBase
@implements IDisposable
@inject UiState Ui
@inject IJSRuntime JS

<MudThemeProvider Theme="ItchTheme.Theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="itch-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" aria-label="@Txt.S("Меню", "Menu")" />
        <MudText Typo="Typo.h6" Class="ml-2 itch-logo">Itch<span>DB</span></MudText>
        <MudText Typo="Typo.caption" Class="ml-3 mud-text-secondary d-none d-md-flex">@Txt.S("локальная аналитика itch.io", "local itch.io analytics")</MudText>
        <MudSpacer />

        <CrawlStatusBar @key="Ui.Language" />

        <MudTooltip Text="@Txt.S("Игры 18+ — отдельная аудитория, которая искажает топы и медианы. По умолчанию скрыты.", "18+ games are a separate audience and skew tops and medians. Hidden by default.")">
            <MudSwitch T="bool" Value="Ui.ShowNsfw" ValueChanged="@(v => Ui.ShowNsfw = v)" Color="Color.Primary"
                       Label="18+" Class="mr-4" />
        </MudTooltip>

        <MudTooltip Text="@Txt.S("Включено: шанс успеха, конкуренция и ниши считаются по всем играм сегмента. Медиана по-прежнему только по играм с оценками. Выключено: те же показатели только среди игр, у которых есть хотя бы одна оценка.", "On: success chance, competition and niches use every game in the segment. The median still uses rated games only. Off: the same figures only among games with at least one rating.")">
            <MudSwitch T="bool" Value="Ui.IncludeUnrated" ValueChanged="@(v => Ui.IncludeUnrated = v)" Color="Color.Primary"
                       Label="@Txt.S("0 оценок", "0 ratings")" Class="mr-4" />
        </MudTooltip>

        <MudTooltip Text="@Txt.S("Медианы и доли считаются только по играм, у которых оценок не меньше порога. У большинства игр оценок нет, поэтому медиана по всем играм всегда 0.", "Medians and shares use only games at or above the threshold. Most games have no ratings, so a median over every game is always 0.")">
            <MudSelect T="int" Value="Ui.MinRatings" ValueChanged="@(v => Ui.MinRatings = v)" Dense="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Label="@Txt.S("Мин. оценок", "Min ratings")" Class="itch-min-select mr-3">
                @foreach (var v in UiState.MinRatingOptions)
                {
                    <MudSelectItem T="int" Value="v">@($"≥ {v}")</MudSelectItem>
                }
            </MudSelect>
        </MudTooltip>

        <MudButtonGroup Variant="Variant.Outlined" OverrideStyles="false" Class="mr-2">
            <MudButton Size="Size.Small" Variant="@(Ui.Language == UiLanguage.En ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="@(() => Ui.Language = UiLanguage.En)">EN</MudButton>
            <MudButton Size="Size.Small" Variant="@(Ui.Language == UiLanguage.Ru ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="@(() => Ui.Language = UiLanguage.Ru)">RU</MudButton>
        </MudButtonGroup>
    </MudAppBar>

    <MudDrawer @key="Ui.Language" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Variant="DrawerVariant.Responsive">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="py-4 px-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    @Txt.S("Произошла ошибка.", "Something went wrong.")
    <a href="." class="reload">@Txt.S("Перезагрузить", "Reload")</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;

    protected override void OnInitialized()
    {
        TextLang.Set(Ui.Language);
        Ui.Changed += OnUiChanged;
    }

    protected override void OnParametersSet() => TextLang.Set(Ui.Language);

    protected override async Task OnAfterRenderAsync(bool firstRender) =>
        await JS.InvokeVoidAsync("itchSetLang", TextLang.Code(Ui.Language));

    private void OnUiChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Ui.Changed -= OnUiChanged;
}
